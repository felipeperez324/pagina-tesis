---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Kodapp",
  description = "Encuentra contenido para personalizar tu celular y PC."
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffdbed" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <link rel="icon" href="/logo.png" type="image/png" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fira+Sans:wght@400;500;600;700&family=Nunito:wght@400;500;600;700&display=swap"
    />
  </head>

  <body>
    <slot />
  </body>
</html>
