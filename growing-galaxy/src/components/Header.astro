---
import logo from "../assets/logo.png";
import { getUsuarioDesdeSesion } from "../lib/auth";

const sessionId =
  Astro.cookies.get("session_id")?.value;

const usuario =
  await getUsuarioDesdeSesion(sessionId);

const pathname =
  Astro.url.pathname;

let homeUrl = "/";

if (usuario) {
  homeUrl =
    usuario.tipo_usuario === "adoptante"
      ? "/usuario"
      : "/gestion";
}
---

<header class="site-header">

  <div class="header-inner">

    <!-- LOGO -->

    <a
      href={homeUrl}
      class="brand"
      aria-label="Ir al inicio de Kodapp"
    >
      <img
        src={logo.src}
        alt="Kodapp"
      />

      <span>Kodapp</span>
    </a>


    <!-- MENÚ MOBILE -->

    <button
      type="button"
      class="mobile-toggle"
      id="mobile-toggle"
      aria-label="Abrir menú"
      aria-expanded="false"
    >
      <i class="fa-solid fa-bars"></i>
    </button>


    <!-- NAVEGACIÓN -->

    <nav
      class="main-nav"
      id="main-nav"
      aria-label="Navegación principal"
    >

      <a
        href={usuario ? homeUrl : "/"}
        class:list={{
          "is-active":
            pathname === "/" ||
            pathname === "/usuario" ||
            pathname === "/gestion"
        }}
      >
        Inicio
      </a>

      <a
        href="/#mascotas"
        class:list={{
          "is-active":
            pathname === "/mascotas"
        }}
      >
        Mascotas
      </a>

      <a
        href="/match"
        class:list={{
          "is-active":
            pathname.startsWith("/match")
        }}
      >
        Compatibilidad
      </a>

      <a href="/#sobre-nosotros">
        Sobre nosotros
      </a>

    </nav>


    <!-- CUENTA -->

    <div class="header-account">

      {
        usuario ? (

          <div class="account-menu">

            <button
              type="button"
              class="account-trigger"
              id="account-trigger"
              aria-expanded="false"
            >

              <span class="account-avatar">
                {
                  usuario.foto_perfil ? (
                    <img
                      src={usuario.foto_perfil}
                      alt="Foto de perfil"
                    />
                  ) : (
                    <i class="fa-solid fa-user"></i>
                  )
                }
              </span>

              <span class="account-name">
                {usuario.nombre}
              </span>

              <i class="fa-solid fa-chevron-down"></i>

            </button>


            <div
              class="account-dropdown"
              id="account-dropdown"
            >

              <div class="account-dropdown-header">

                <strong>
                  {usuario.nombre}
                </strong>

                <span>
                  {
                    usuario.tipo_usuario === "adoptante"
                      ? "Adoptante"
                      : usuario.tipo_usuario === "rescatista"
                        ? "Rescatista"
                        : "Veterinario"
                  }
                </span>

              </div>


              <a href={homeUrl}>
                <i class="fa-solid fa-house"></i>
                Mi cuenta
              </a>

              <a href="/perfil">
                <i class="fa-solid fa-user"></i>
                Mi perfil
              </a>

              <button
                type="button"
                id="header-logout"
              >
                <i class="fa-solid fa-right-from-bracket"></i>
                Cerrar sesión
              </button>

            </div>

          </div>

        ) : (

          <a
            href="/login"
            class="header-login"
          >
            <i class="fa-solid fa-user"></i>
            <span>Iniciar sesión</span>
          </a>

        )
      }

    </div>

  </div>

</header>


<script>
  // =========================================
  // MENÚ MOBILE
  // =========================================

  const mobileToggle =
    document.querySelector(
      "#mobile-toggle"
    ) as HTMLButtonElement | null;

  const mainNav =
    document.querySelector(
      "#main-nav"
    ) as HTMLElement | null;


  mobileToggle?.addEventListener(
    "click",
    () => {

      const isOpen =
        mainNav?.classList.toggle(
          "is-open"
        ) ?? false;

      mobileToggle.setAttribute(
        "aria-expanded",
        String(isOpen)
      );

    }
  );


  // =========================================
  // MENÚ DE CUENTA
  // =========================================

  const accountTrigger =
    document.querySelector(
      "#account-trigger"
    ) as HTMLButtonElement | null;

  const accountDropdown =
    document.querySelector(
      "#account-dropdown"
    ) as HTMLElement | null;


  accountTrigger?.addEventListener(
    "click",
    () => {

      const isOpen =
        accountDropdown?.classList.toggle(
          "is-open"
        ) ?? false;

      accountTrigger.setAttribute(
        "aria-expanded",
        String(isOpen)
      );

    }
  );


  // =========================================
  // CERRAR SESIÓN
  // =========================================

  const logoutButton =
    document.querySelector(
      "#header-logout"
    ) as HTMLButtonElement | null;


  logoutButton?.addEventListener(
    "click",
    async () => {

      try {

        const response =
          await fetch(
            "/api/logout",
            {
              method: "POST"
            }
          );


        const data =
          await response.json();


        if (data.ok) {

          window.location.href =
            "/";

          return;
        }


        alert(
          data.mensaje ||
          "No se pudo cerrar la sesión."
        );


      } catch (error) {

        console.error(
          "Error al cerrar sesión:",
          error
        );

        alert(
          "No se pudo cerrar la sesión."
        );

      }

    }
  );
</script>