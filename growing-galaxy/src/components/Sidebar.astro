---
import ProductCard from "./ProductCard.astro";
import ContentCarousel from "./ContentCarousel.astro";
---

<aside class="sidebar">
  <section class="sidebar-widget youtube-widget">
    <h3>Visita mi canal de Youtube ⬇</h3>
    <div class="widget-body">
      <div class="youtube-hero">
        <img src="/bu.jpg" alt="Canal de YouTube de Kodapp" loading="lazy" />
        <a
          href="https://www.youtube.com/watch?v=Vo0gUHy96PM"
          target="_blank"
          rel="noopener noreferrer"
          class="pink-button overlay"
        >
          nosequeponer
        </a>
      </div>
    </div>
  </section>

  <section class="sidebar-widget">
    <h3>Kodapp</h3>
    <div class="widget-body">
      <ProductCard />
    </div>
  </section>

  <section class="sidebar-widget">
    <h3>Más contenido!!</h3>
    <div class="widget-body">
      <ContentCarousel />
    </div>
  </section>
</aside>
