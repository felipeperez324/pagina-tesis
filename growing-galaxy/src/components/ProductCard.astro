---
const translations = {
  es: {
    title: "Curso: Crea tu propio pinterest de colores!!",
    button: "Ver ahora"
  },
  en: {
    title: "Course: Create your own colorful Pinterest!!",
    button: "View now"
  },
  pt: {
    title: "Curso: Crie seu próprio Pinterest colorido!!",
    button: "Ver agora"
  }
};
---

<section class="product-widget" aria-label="Curso Kodapp">
  <div class="language-tabs">
    {Object.entries(translations).map(([lang], index) => (
      <button type="button" class:list={{ active: index === 0 }} data-lang={lang}>
        {lang.toUpperCase()}
      </button>
    ))}
  </div>

  <a
    class="product-card"
    href="https://Kodappacademy.blogspot.com/2026/07/pinterest%20de%20colores.html"
    target="_blank"
    rel="nofollow noopener noreferrer"
  >
    <div class="product-thumb">
      <img
        src="https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEjZi03_Dn329NP48cjjYncFjviEy7v3BfHg5R3cbeTUESi2FWKddEw4WgNCJEICzVB1aH7ndAm7hc_0ytsqeF6a0LHfBh1QQCCcnTyhB5w60g7uVsJbRgal7UEk8qDam-QBC8kgl4sn5JV0HS3mWMsVcF2W7i4TIZiyqrmhjcaX6AXXzxWlQX5-UJnz2T5k/s1600/cursoportada.jpg"
        alt="Portada del curso"
        loading="lazy"
      />
    </div>

    <div class="product-info">
      <h3 id="kc-title">{translations.es.title}</h3>

      <div class="rating">
        <span aria-label="5 estrellas">★★★★★</span>
        <small>4.9 / 5.0</small>
      </div>

      <div class="product-action">
        <span id="kc-btn">{translations.es.button}</span>
        <strong>-10%</strong>
      </div>
    </div>
  </a>
</section>

<script define:vars={{ translations }}>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".language-tabs button");
  const title = document.querySelector("#kc-title");
  const action = document.querySelector("#kc-btn");

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const lang = button.dataset.lang as keyof typeof translations;
      if (!translations[lang]) return;

      buttons.forEach((item) => item.classList.remove("active"));
      button.classList.add("active");

      if (title) title.textContent = translations[lang].title;
      if (action) action.textContent = translations[lang].button;
    });
  });
</script>
