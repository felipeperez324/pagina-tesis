---

<section class="content-carousel" aria-label="Más contenido">
  <div class="carousel-track">
    {slides.map((slide) => (
      <article class="carousel-slide">
        <img src={slide.image} alt={slide.alt} loading="lazy" />
        <div>
          <a href={slide.href} class="pink-button" target="_blank" rel="noopener noreferrer">
            {slide.button}
          </a>
          <p>{slide.text}</p>
        </div>
      </article>
    ))}
  </div>

  <div class="carousel-dots" aria-hidden="true">
    <button class="active" type="button"></button>
    <button type="button"></button>
  </div>
</section>

<script>
  const carousel = document.querySelector(".content-carousel");
  const track = carousel?.querySelector<HTMLElement>(".carousel-track");
  const slides = carousel?.querySelectorAll(".carousel-slide");
  const dots = carousel?.querySelectorAll<HTMLButtonElement>(".carousel-dots button");
  let index = 0;

  function goTo(next: number) {
    if (!track || !slides?.length) return;
    index = next % slides.length;
    track.style.transform = `translateX(-${index * 100}%)`;
    dots?.forEach((dot, i) => dot.classList.toggle("active", i === index));
  }

  dots?.forEach((dot, i) => dot.addEventListener("click", () => goTo(i)));
  setInterval(() => goTo(index + 1), 4000);
</script>
