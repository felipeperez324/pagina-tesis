
---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import MascotasDisponibles from "../components/MascotasDisponibles.astro";
import { getUsuarioDesdeSesion } from "../lib/auth";

const sessionId = Astro.cookies.get("session_id")?.value;
const usuario = await getUsuarioDesdeSesion(sessionId);

if (!usuario) {
  return Astro.redirect("/login");
}

if (usuario.tipo_usuario !== "adoptante") {
  return Astro.redirect("/gestion");
}
---

<Layout
  title="Mi cuenta | KodApp"
  description="Panel del adoptante de KodApp."
>
  <Header />

  <main class="dashboard-page">
    <div class="dashboard-container">

      <!-- BIENVENIDA -->
      <section class="dashboard-welcome">

        <div class="dashboard-welcome-content">

          <span class="section-kicker">
            Mi espacio
          </span>

          <h1>
            Hola, {usuario.nombre}.
          </h1>

          <p>
            Descubre mascotas, encuentra compatibilidades
            y administra tus procesos de adopción.
          </p>

        </div>

        <!-- FOTO DE PERFIL -->
        <div class="dashboard-profile">

          <div
            class="dashboard-avatar"
            id="profile-photo"
          >
            {
              usuario.foto_perfil ? (
                <img
                  src={usuario.foto_perfil}
                  alt="Foto de perfil"
                />
              ) : (
                <i class="fa-solid fa-user"></i>
              )
            }
          </div>

          <label
            for="photo-input"
            class="photo-change-button"
          >
            <i class="fa-solid fa-camera"></i>
            Cambiar foto
          </label>

          <input
            id="photo-input"
            type="file"
            accept="image/png,image/jpeg,image/webp"
            hidden
          />

        </div>

      </section>

      <!-- ACCIONES -->
      <section class="dashboard-actions">

        <a
          href="/match"
          class="dashboard-action-card dashboard-action-primary"
        >
          <div class="dashboard-action-icon">
            <i class="fa-solid fa-heart-circle-bolt"></i>
          </div>

          <div>
            <span>Encuentra tu match</span>
            <h2>Compatibilidad</h2>
            <p>
              Descubre qué mascotas pueden
              encajar mejor contigo.
            </p>
          </div>

          <i class="fa-solid fa-arrow-right"></i>
        </a>

        <a
          href="/perfil"
          class="dashboard-action-card"
        >
          <div class="dashboard-action-icon">
            <i class="fa-solid fa-user"></i>
          </div>

          <div>
            <span>Tu información</span>
            <h2>Mi perfil</h2>
            <p>
              Revisa y administra tus datos personales.
            </p>
          </div>

          <i class="fa-solid fa-arrow-right"></i>
        </a>

        <a
          href="/formularios"
          class="dashboard-action-card"
        >
          <div class="dashboard-action-icon">
            <i class="fa-solid fa-clipboard-check"></i>
          </div>

          <div>
            <span>Tu proceso</span>
            <h2>Formularios respondidos</h2>
            <p>
              Revisa los formularios que has completado.
            </p>
          </div>

          <i class="fa-solid fa-arrow-right"></i>
        </a>

      </section>

      <!-- LISTADO DE MASCOTAS -->
      <MascotasDisponibles />

    </div>
  </main>
</Layout>

<script>
  const photoInput = document.querySelector<HTMLInputElement>(
    "#photo-input"
  );

  const profilePhoto = document.querySelector<HTMLElement>(
    "#profile-photo"
  );

  photoInput?.addEventListener("change", async () => {
    const archivo = photoInput.files?.[0];

    if (!archivo || !profilePhoto) return;

    if (
      !["image/jpeg", "image/png", "image/webp"]
        .includes(archivo.type)
    ) {
      alert("La imagen debe ser JPG, PNG o WebP.");
      photoInput.value = "";
      return;
    }

    if (archivo.size > 5 * 1024 * 1024) {
      alert("La imagen no puede superar los 5 MB.");
      photoInput.value = "";
      return;
    }

    const datos = new FormData();
    datos.append("foto", archivo);

    profilePhoto.style.opacity = "0.5";

    try {
      const respuesta = await fetch("/api/perfil/foto", {
        method: "POST",
        body: datos
      });

      const resultado = await respuesta.json();

      if (!respuesta.ok || !resultado.ok) {
        alert(
          resultado.mensaje || "No se pudo guardar la foto."
        );
        return;
      }

      // Actualizar el avatar.
      const imagen = document.createElement("img");
      imagen.src = resultado.foto;
      imagen.alt = "Foto de perfil";

      profilePhoto.replaceChildren(imagen);

      // Recargar para actualizar también el encabezado.
      window.location.reload();

    } catch (error) {
      console.error("Error al cambiar foto:", error);
      alert("No se pudo guardar la foto.");

    } finally {
      profilePhoto.style.opacity = "1";
    }
  });
</script>
