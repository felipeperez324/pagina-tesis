---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import { getUsuarioDesdeSesion } from "../lib/auth";
import MascotasDisponibles from "../components/MascotasDisponibles.astro";

const sessionId =
  Astro.cookies.get("session_id")?.value;

const usuario =
  await getUsuarioDesdeSesion(sessionId);


if (!usuario) {
  return Astro.redirect("/login");
}


if (usuario.tipo_usuario !== "adoptante") {
  return Astro.redirect("/gestion");
}
---

<Layout
  title="Mi cuenta | Kodapp"
  description="Panel del adoptante de Kodapp."
>

  <Header />


  <main class="dashboard-page">

    <div class="dashboard-container">


      <!-- ========================================= -->
      <!-- CABECERA -->
      <!-- ========================================= -->

      <section class="dashboard-welcome">

        <div class="dashboard-welcome-content">

          <span class="section-kicker">
            Mi espacio
          </span>

          <h1>
            Hola, {usuario.nombre}.
          </h1>

          <p>
            Descubre mascotas, encuentra compatibilidades
            y administra tus procesos de adopción.
          </p>

        </div>


        <div class="dashboard-profile">

          <div
            class="dashboard-avatar"
            id="profile-photo"
          >

            {
              usuario.foto_perfil ? (

                <img
                  src={usuario.foto_perfil}
                  alt="Foto de perfil"
                />

              ) : (

                <i class="fa-solid fa-user"></i>

              )
            }

          </div>


          <label
            for="photo-input"
            class="photo-change-button"
          >
            <i class="fa-solid fa-camera"></i>
            Cambiar foto
          </label>


          <input
            id="photo-input"
            type="file"
            accept="image/*"
            hidden
          />

        </div>

      </section>


      <!-- ========================================= -->
      <!-- ACCIONES -->
      <!-- ========================================= -->

      <section class="dashboard-actions">

        <a
          href="/match"
          class="dashboard-action-card dashboard-action-primary"
        >

          <div class="dashboard-action-icon">
            <i class="fa-solid fa-heart-circle-bolt"></i>
          </div>

          <div>
            <span>Encuentra tu match</span>

            <h2>
              Compatibilidad
            </h2>

            <p>
              Descubre qué mascotas pueden encajar mejor contigo.
            </p>
          </div>

          <i class="fa-solid fa-arrow-right"></i>

        </a>


        <a
          href="/perfil"
          class="dashboard-action-card"
        >

          <div class="dashboard-action-icon">
            <i class="fa-solid fa-user"></i>
          </div>

          <div>
            <span>Tu información</span>

            <h2>
              Mi perfil
            </h2>

            <p>
              Revisa y administra tus datos personales.
            </p>
          </div>

          <i class="fa-solid fa-arrow-right"></i>

        </a>


        <a
          href="/formularios"
          class="dashboard-action-card"
        >

          <div class="dashboard-action-icon">
            <i class="fa-solid fa-clipboard-check"></i>
          </div>

          <div>
            <span>Tu proceso</span>

            <h2>
              Formularios respondidos
            </h2>

            <p>
              Revisa los formularios que has completado.
            </p>
          </div>

          <i class="fa-solid fa-arrow-right"></i>

        </a>

      </section>


      <!-- ========================================= -->
      <!-- MASCOTAS -->
      <!-- ========================================= -->

      <MascotasDisponibles />

    </div>

  </main>

</Layout>


<script>
  // =========================================
  // CAMBIAR FOTO DE PERFIL
  // =========================================

  const photoInput =
    document.querySelector(
      "#photo-input"
    ) as HTMLInputElement | null;


  const profilePhoto =
    document.querySelector(
      "#profile-photo"
    ) as HTMLDivElement | null;


  photoInput?.addEventListener(
    "change",
    async () => {

      const file =
        photoInput.files?.[0];


      if (!file || !profilePhoto) {
        return;
      }


      if (
        !file.type.startsWith(
          "image/"
        )
      ) {

        alert(
          "El archivo debe ser una imagen."
        );

        photoInput.value =
          "";

        return;
      }


      if (
        file.size >
        5 * 1024 * 1024
      ) {

        alert(
          "La imagen no puede superar los 5 MB."
        );

        photoInput.value =
          "";

        return;
      }


      const formData =
        new FormData();


      formData.append(
        "foto",
        file
      );


      try {

        profilePhoto.style.opacity =
          "0.5";


        const response =
          await fetch(
            "/api/perfil/foto",
            {
              method: "POST",
              body: formData,
            }
          );


        const data =
          await response.json();


        if (
          !response.ok ||
          !data.ok
        ) {

          alert(
            data.mensaje ||
            "No se pudo guardar la foto."
          );

          return;
        }


        profilePhoto.innerHTML =
          "";


        const image =
          document.createElement(
            "img"
          );


        image.src =
          data.foto;

        image.alt =
          "Foto de perfil";


        profilePhoto.appendChild(
          image
        );


      } catch (error) {

        console.error(
          "Error al guardar foto:",
          error
        );


        alert(
          "No se pudo guardar la foto."
        );


      } finally {

        profilePhoto.style.opacity =
          "1";

      }

    }
  );
</script>