---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import { db } from "../../lib/db";
import { urlFotoMascota } from "../../lib/fotos";
import CarruselMascota from "../../components/CarruselMascota.astro";

export const prerender = false;

const id = Number(Astro.params.id);

if (!Number.isSafeInteger(id) || id <= 0) {
  return Astro.redirect("/mascotas");
}

// Consultar la ficha y la organización.
const resultado = await db.query(
  `SELECT
    m.*,
    u.nombre AS organizacion,
    EXISTS (
      SELECT 1
      FROM mascotas_postulables mp
      WHERE mp.id = m.id
    ) AS postulable
   FROM mascotas m
   JOIN usuarios u ON u.id = m.usuario_id
   WHERE m.id = $1
     AND u.estado_cuenta = 'activo'
     AND m.publicada = TRUE`,
  [id]
);

if (resultado.rows.length === 0) {
  return Astro.redirect("/mascotas");
}

const mascota = resultado.rows[0];

// Obtener las fotos adicionales.
const resultadoFotos = await db.query(
  `SELECT id
   FROM mascotas_fotos
   WHERE mascota_id = $1
   ORDER BY orden`,
  [id]
);

// Foto principal existente.
const fotoPrincipal = urlFotoMascota(
  id,
  mascota.foto_blob
);

// Construir galería.
const fotos = [
  ...(fotoPrincipal ? [fotoPrincipal] : []),
  ...resultadoFotos.rows.map(
    (foto) => `/api/fotos/galeria/${foto.id}`
  )
];

function mostrarBooleano(valor: boolean | null) {
  if (valor === null) return "Sin especificar";
  return valor ? "Sí" : "No";
}

function mostrarEdad(meses: number | null) {
  if (meses === null) return "Sin especificar";
  if (meses < 12) return `${meses} meses`;

  const anos = Math.floor(meses / 12);
  const resto = meses % 12;

  return `${anos} año(s)${
    resto ? ` y ${resto} meses` : ""
  }`;
}
---

<Layout
  title={`Ficha de ${mascota.nombre} | KodaApp`}
  description={`Conoce a ${mascota.nombre}`}
>
  <Header />

  <main class="ficha">
    <a href="/mascotas" class="volver">
      ← Volver a mascotas
    </a>

    <div class="ficha-encabezado">
      <div>
        <span class="section-kicker">Ficha de adopción</span>
        <h1>Conoce a {mascota.nombre}</h1>
        <p><i class="fa-solid fa-building" aria-hidden="true"></i>{" "}Organización: {mascota.organizacion}</p>
      </div>
      <span class:list={["ficha-estado", { disponible: mascota.postulable }]}>{mascota.postulable ? "Disponible para postular" : "No disponible para postular"}</span>
    </div>

    <div class="contenido">
      
        <section class="panel">
        <h2>Fotografías</h2>

        <CarruselMascota
            fotos={fotos}
            nombre={mascota.nombre}
        />
        </section>


      <section class="panel">
        <h2>Información general</h2>

        <dl class="datos">
          <div><dt>Nombre</dt><dd>{mascota.nombre}</dd></div>
          <div><dt>Tipo</dt><dd>{mascota.tipo_mascota}</dd></div>
          <div><dt>Raza</dt><dd>{mascota.raza ?? "Sin especificar"}</dd></div>
          <div><dt>Edad</dt><dd>{mostrarEdad(mascota.edad_meses)}</dd></div>
          <div><dt>Sexo</dt><dd>{mascota.sexo ?? "Sin especificar"}</dd></div>
          <div><dt>Tamaño</dt><dd>{mascota.tamano ?? "Sin especificar"}</dd></div>
          <div><dt>Ubicación</dt><dd>{mascota.ubicacion ?? "Sin especificar"}</dd></div>
          <div><dt>Esterilizado</dt><dd>{mostrarBooleano(mascota.esterilizado)}</dd></div>
          <div><dt>Vacunas al día</dt><dd>{mostrarBooleano(mascota.vacunas_al_dia)}</dd></div>
        </dl>
      </section>
    </div>

    <section class="panel">
      <h2>Descripción</h2>
      <p>{mascota.descripcion || "Sin descripción."}</p>

      <h2>Personalidad</h2>
      <p>{mascota.personalidad || "Sin especificar."}</p>

      <h2>Historial médico</h2>
      <p>{mascota.historial_medico || "Sin antecedentes informados."}</p>

      <h2>Requisitos de adopción</h2>
      <p>{mascota.requisitos_adopcion || "Consultar con la organización."}</p>
    </section>

    {mascota.postulable ? (
      <a class="btn-primary boton-postular" href={`/postular/${id}`}>
        Postular para adoptar
      </a>
    ) : (
      <p>Esta mascota no está disponible para nuevas postulaciones.</p>
    )}
  </main>
</Layout>



<style>
  .ficha { max-width:1160px; margin:32px auto; padding:20px; color:var(--text); }
  .volver { display:inline-flex; align-items:center; gap:8px; margin-bottom:18px; color:var(--cyan); font-size:13px; font-weight:800; text-decoration:none; }
  .ficha-encabezado { display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap; }
  .ficha-encabezado h1 { font-size:clamp(28px,4vw,40px); margin:8px 0; overflow-wrap:anywhere; }
  .ficha-encabezado p { color:var(--muted); }
  .ficha-estado { display:inline-flex; align-items:center; padding:9px 14px; background:var(--surface); border:1px solid var(--border-light); border-radius:999px; color:var(--muted); font-size:12px; font-weight:800; }
  .ficha-estado.disponible { color:var(--success); border-color:var(--success); }
  .contenido { display:grid; grid-template-columns:1fr 1fr; gap:22px; margin:25px 0; align-items:start; }
  .panel { background:var(--surface); border:1px solid var(--border-light); border-radius:18px; padding:24px; margin-bottom:22px; min-width:0; box-shadow:0 8px 24px #0003; }
  .contenido .panel { margin-bottom:0; }
  .panel h2 { color:var(--text); font-size:19px; margin:0 0 14px; }
  .panel p { white-space:pre-wrap; overflow-wrap:anywhere; color:var(--text-soft); line-height:1.65; margin:0 0 22px; }
  .panel p:last-child { margin-bottom:0; }
  .datos { display:grid; gap:8px; margin:0; }
  .datos div { display:flex; justify-content:space-between; align-items:baseline; gap:15px; padding:12px 14px; background:var(--bg-soft); border:1px solid var(--border); border-radius:9px; }
  .datos dt { color:var(--muted); font-size:13px; font-weight:700; }
  .datos dd { margin:0; text-align:right; color:var(--text-soft); font-size:14px; overflow-wrap:anywhere; min-width:0; }
  .boton-postular { display:inline-flex; align-items:center; justify-content:center; gap:8px; min-height:46px; text-decoration:none; }
  @media(max-width:768px) { .contenido { grid-template-columns:1fr; } .panel { padding:17px; } .ficha { padding:15px; } .boton-postular { width:100%; } }
</style>
