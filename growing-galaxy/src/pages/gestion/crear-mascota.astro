
---
/**
 * KODAPP - PUBLICAR MASCOTA
 *
 * Solo para organizaciones.
 * Personalidad y salud mediante desplegables.
 */

import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import ClasificacionMascota from "../../components/ClasificacionMascota.astro";
import { getUsuarioDesdeSesion } from "../../lib/auth";

export const prerender = false;

const sessionId =
  Astro.cookies.get("session_id")?.value;

const usuario =
  await getUsuarioDesdeSesion(sessionId);

if (!usuario) {
  return Astro.redirect("/login");
}

if (usuario.tipo_usuario !== "organizacion") {
  return Astro.redirect("/usuario");
}
---

<Layout
  title="Publicar mascota | KodApp"
  description="Publica una mascota para adopción."
>
  <Header />

  <main class="form-page">
    <div class="form-page-container">

      <!-- ENCABEZADO -->

      <div class="page-header">

        <a href="/gestion" class="back-link">
          <i class="fa-solid fa-arrow-left"></i>
          Volver al panel
        </a>

        <span class="section-kicker">
          Nueva publicación
        </span>

        <h1>Publicar una mascota</h1>

        <p>
          Completa la información para que
          los adoptantes puedan conocerla mejor.
        </p>
      </div>


      <!-- FORMULARIO -->

      <form
        id="mascota-form"
        class="publication-form"
      >

        <!-- FOTO -->

        <section class="form-section">

          <div class="form-section-header">

            <span class="form-step">01</span>

            <div>
              <h2>Imagen de la mascota</h2>
              <p>Una buena foto ayuda a conocerla mejor.</p>
            </div>

          </div>

          <div class="upload-area">

            <label for="foto" class="upload-label">

              <div
                id="preview-container"
                class="photo-preview"
              >
                <i class="fa-solid fa-camera"></i>
                <span>Seleccionar imagen</span>
              </div>

            </label>

            <input
              type="file"
              id="foto"
              name="foto"
              accept="image/jpeg,image/png,image/webp"
              hidden
            />

            <small>
              JPG, PNG o WebP. Máximo 5 MB.
            </small>

          </div>

        </section>


        <!-- INFORMACIÓN BÁSICA -->

        <section class="form-section">

          <div class="form-section-header">

            <span class="form-step">02</span>

            <div>
              <h2>Información básica</h2>
              <p>Cuéntanos quién es esta mascota.</p>
            </div>

          </div>

          <div class="form-grid">

            <div class="form-field">

              <label for="nombre">
                Nombre de la mascota
              </label>

              <input
                id="nombre"
                name="nombre"
                type="text"
                maxlength="100"
                placeholder="Ej: Firulais"
                required
              />

            </div>


            <div class="form-field">

              <label for="tipo-mascota">
                Tipo de mascota
              </label>

              <select
                id="tipo-mascota"
                name="tipoMascota"
                required
              >
                <option value="">
                  Selecciona una opción
                </option>

                <option value="perro">Perro</option>
                <option value="gato">Gato</option>
                <option value="otro">Otro</option>
              </select>

            </div>


            <div class="form-field form-field-full">

              <label for="descripcion">
                Descripción
              </label>

              <textarea
                id="descripcion"
                name="descripcion"
                rows="5"
                maxlength="5000"
                placeholder="Cuéntanos sobre la mascota..."
              ></textarea>

            </div>

          </div>

        </section>


        <!-- DESPLEGABLES -->
        <!-- El componente incluye las secciones
             03 Personalidad y 04 Salud. -->

        <ClasificacionMascota />


        <!-- MENSAJES -->

        <p
          id="form-message"
          class="form-message"
          role="status"
          aria-live="polite"
        ></p>


        <!-- ACCIONES -->

        <div class="form-actions">

          <a href="/gestion" class="btn-outline">
            Cancelar
          </a>

          <button
            type="submit"
            id="publish-button"
            class="btn-primary"
          >
            Publicar mascota
            <i class="fa-solid fa-paw"></i>
          </button>

        </div>

      </form>
    </div>
  </main>
</Layout>


<script>
  const form =
    document.querySelector<HTMLFormElement>(
      "#mascota-form"
    );

  const photoInput =
    document.querySelector<HTMLInputElement>(
      "#foto"
    );

  const previewContainer =
    document.querySelector<HTMLElement>(
      "#preview-container"
    );

  const message =
    document.querySelector<HTMLElement>(
      "#form-message"
    );

  const publishButton =
    document.querySelector<HTMLButtonElement>(
      "#publish-button"
    );


  // ==========================================
  // VISTA PREVIA DE LA FOTO
  // ==========================================

  photoInput?.addEventListener("change", () => {
    const archivo = photoInput.files?.[0];

    if (!archivo || !previewContainer) {
      return;
    }

    const tiposPermitidos = [
      "image/jpeg",
      "image/png",
      "image/webp"
    ];

    if (
      !tiposPermitidos.includes(archivo.type) ||
      archivo.size > 5 * 1024 * 1024
    ) {
      alert(
        "Selecciona una imagen JPG, PNG o WebP de hasta 5 MB."
      );

      photoInput.value = "";
      return;
    }

    const url = URL.createObjectURL(archivo);
    const imagen = document.createElement("img");

    imagen.src = url;
    imagen.alt = "Vista previa de la mascota";

    imagen.onload = () => {
      URL.revokeObjectURL(url);
    };

    previewContainer.replaceChildren(imagen);
  });


  // ==========================================
  // PUBLICAR MASCOTA
  // ==========================================

  form?.addEventListener("submit", async (evento) => {
    evento.preventDefault();

    if (!form || !publishButton || !message) {
      return;
    }

    if (!form.reportValidity()) {
      return;
    }

    publishButton.disabled = true;
    message.textContent = "Publicando mascota...";

    const textoOriginal = publishButton.innerHTML;

    try {
      const datos = new FormData(form);

      const respuesta = await fetch(
        "/api/mascotas/crear",
        {
          method: "POST",
          credentials: "same-origin",
          body: datos
        }
      );

      const resultado = await respuesta.json();

      if (respuesta.status === 401) {
        window.location.href = "/login";
        return;
      }

      if (!respuesta.ok || !resultado.ok) {
        message.textContent =
          resultado.mensaje ||
          "No se pudo publicar la mascota.";
        return;
      }

      window.location.href = "/gestion/mascotas";

    } catch (error) {
      console.error("Error al publicar mascota:", error);

      message.textContent =
        "No se pudo conectar con el servidor.";

    } finally {
      publishButton.disabled = false;
      publishButton.innerHTML = textoOriginal;
    }
  });
</script>
