---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import { getUsuarioDesdeSesion } from "../../lib/auth";

const sessionId =
  Astro.cookies.get("session_id")?.value;

const usuario =
  await getUsuarioDesdeSesion(sessionId);


if (!usuario) {
  return Astro.redirect("/login");
}


if (
  usuario.tipo_usuario !== "rescatista" &&
  usuario.tipo_usuario !== "veterinario"
) {
  return Astro.redirect("/usuario");
}
---

<Layout
  title="Publicar mascota | Kodapp"
  description="Publica una mascota para adopción."
>

  <Header />


  <main class="form-page">

    <div class="form-page-container">


      <!-- ========================================= -->
      <!-- ENCABEZADO -->
      <!-- ========================================= -->

      <div class="page-header">

        <a
          href="/gestion"
          class="back-link"
        >
          <i class="fa-solid fa-arrow-left"></i>
          Volver al panel
        </a>

        <span class="section-kicker">
          Nueva publicación
        </span>

        <h1>
          Publicar una mascota
        </h1>

        <p>
          Completa la información para que
          los adoptantes puedan conocerla mejor.
        </p>

      </div>


      <!-- ========================================= -->
      <!-- FORMULARIO -->
      <!-- ========================================= -->

      <form
        id="mascota-form"
        class="publication-form"
      >


        <!-- FOTO -->

        <section class="form-section">

          <div class="form-section-header">

            <span class="form-step">
              01
            </span>

            <div>

              <h2>
                Imagen de la mascota
              </h2>

              <p>
                Una buena foto ayuda a mostrar su personalidad.
              </p>

            </div>

          </div>


          <div class="upload-area">

            <label
              for="foto"
              class="upload-label"
            >

              <div
                id="preview-container"
                class="photo-preview"
              >

                <i class="fa-solid fa-camera"></i>

                <span>
                  Seleccionar imagen
                </span>

              </div>

            </label>


            <input
              type="file"
              id="foto"
              name="foto"
              accept="image/*"
              hidden
            />


            <small>
              Formatos de imagen permitidos.
              Máximo 5 MB.
            </small>

          </div>

        </section>


        <!-- INFORMACIÓN BÁSICA -->

        <section class="form-section">

          <div class="form-section-header">

            <span class="form-step">
              02
            </span>

            <div>

              <h2>
                Información básica
              </h2>

              <p>
                Cuéntanos quién es esta mascota.
              </p>

            </div>

          </div>


          <div class="form-grid">

            <div class="form-field">

              <label for="nombre">
                Nombre de la mascota
              </label>

              <input
                type="text"
                id="nombre"
                name="nombre"
                maxlength="100"
                placeholder="Ej: Firulais"
                required
              />

            </div>


            <div class="form-field">

              <label for="tipo-mascota">
                Tipo de mascota
              </label>

              <select
                id="tipo-mascota"
                name="tipoMascota"
                required
              >

                <option value="">
                  Selecciona una opción
                </option>

                <option value="perro">
                  Perro
                </option>

                <option value="gato">
                  Gato
                </option>

                <option value="otro">
                  Otro
                </option>

              </select>

            </div>


            <div class="form-field form-field-full">

              <label for="descripcion">
                Descripción
              </label>

              <textarea
                id="descripcion"
                name="descripcion"
                rows="5"
                placeholder="Cuéntanos sobre la mascota..."
              ></textarea>

            </div>

          </div>

        </section>


        <!-- PERSONALIDAD -->

        <section class="form-section">

          <div class="form-section-header">

            <span class="form-step">
              03
            </span>

            <div>

              <h2>
                Personalidad
              </h2>

              <p>
                Describe cómo es y qué la caracteriza.
              </p>

            </div>

          </div>


          <div class="form-field">

            <label for="personalidad">
              Personalidad
            </label>

            <textarea
              id="personalidad"
              name="personalidad"
              rows="5"
              placeholder="Ej: Es tranquila, cariñosa y juguetona."
            ></textarea>

          </div>

        </section>


        <!-- SALUD -->

        <section class="form-section">

          <div class="form-section-header">

            <span class="form-step">
              04
            </span>

            <div>

              <h2>
                Historial médico
              </h2>

              <p>
                Agrega cualquier información de salud relevante.
              </p>

            </div>

          </div>


          <div class="form-field">

            <label for="historial-medico">
              Historial médico
            </label>

            <textarea
              id="historial-medico"
              name="historialMedico"
              rows="5"
              placeholder="Vacunas, tratamientos, condiciones médicas, etc."
            ></textarea>

          </div>

        </section>


        <!-- MENSAJE -->

        <p
          id="form-message"
          class="form-message"
        ></p>


        <!-- BOTONES -->

        <div class="form-actions">

          <a
            href="/gestion"
            class="btn-outline"
          >
            Cancelar
          </a>

          <button
            type="submit"
            id="publish-button"
            class="btn-primary"
          >
            Publicar mascota
            <i class="fa-solid fa-paw"></i>
          </button>

        </div>

      </form>

    </div>

  </main>

</Layout>


<script>
  // =========================================
  // ELEMENTOS
  // =========================================

  const form =
    document.querySelector(
      "#mascota-form"
    ) as HTMLFormElement | null;

  const photoInput =
    document.querySelector(
      "#foto"
    ) as HTMLInputElement | null;

  const previewContainer =
    document.querySelector(
      "#preview-container"
    ) as HTMLElement | null;

  const message =
    document.querySelector(
      "#form-message"
    ) as HTMLElement | null;

  const publishButton =
    document.querySelector(
      "#publish-button"
    ) as HTMLButtonElement | null;


  // =========================================
  // VISTA PREVIA
  // =========================================

  photoInput?.addEventListener(
    "change",
    () => {

      const file =
        photoInput.files?.[0];


      if (
        !file ||
        !previewContainer
      ) {
        return;
      }


      if (
        !file.type.startsWith(
          "image/"
        )
      ) {

        alert(
          "El archivo debe ser una imagen."
        );

        photoInput.value =
          "";

        return;
      }


      if (
        file.size >
        5 * 1024 * 1024
      ) {

        alert(
          "La imagen no puede superar los 5 MB."
        );

        photoInput.value =
          "";

        return;
      }


      const imageUrl =
        URL.createObjectURL(file);


      previewContainer.innerHTML =
        "";


      const image =
        document.createElement(
          "img"
        );


      image.src =
        imageUrl;

      image.alt =
        "Vista previa de la mascota";


      previewContainer.appendChild(
        image
      );

    }
  );


  // =========================================
  // ENVIAR FORMULARIO
  // =========================================

  form?.addEventListener(
    "submit",
    async (event) => {

      event.preventDefault();


      if (
        !publishButton ||
        !message
      ) {
        return;
      }


      publishButton.disabled =
        true;

      publishButton.innerHTML =
        "Publicando...";


      message.textContent =
        "";


      const formData =
        new FormData(form);


      try {

        const response =
          await fetch(
            "/api/mascotas/crear",
            {
              method: "POST",
              body: formData,
            }
          );


        const data =
          await response.json();


        if (
          !response.ok ||
          !data.ok
        ) {

          message.textContent =
            data.mensaje ||
            "No se pudo publicar la mascota.";

          publishButton.disabled =
            false;

          publishButton.innerHTML =
            'Publicar mascota <i class="fa-solid fa-paw"></i>';

          return;
        }


        message.textContent =
          "¡Mascota publicada correctamente!";


        setTimeout(
          () => {

            window.location.href =
              "/gestion/mascotas";

          },
          800
        );


      } catch (error) {

        console.error(
          "Error al publicar:",
          error
        );


        message.textContent =
          "Ocurrió un error al publicar la mascota.";


        publishButton.disabled =
          false;

        publishButton.innerHTML =
          'Publicar mascota <i class="fa-solid fa-paw"></i>';

      }

    }
  );
</script>