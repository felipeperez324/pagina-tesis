---
import PaginadorMascotas from "../../components/PaginadorMascotas.astro";
import { leerBusqueda, calcularPagina, enlacePagina, MASCOTAS_POR_PAGINA } from "../../lib/paginacionMascotas";
import "../../styles/catalogo-mascotas.css";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import { getUsuarioDesdeSesion } from "../../lib/auth";
import { db } from "../../lib/db";
import { agregarFotosMascotas } from "../../lib/fotos";

export const prerender = false;
Astro.response.headers.set("Cache-Control", "private, no-store");
const sessionId = Astro.cookies.get("session_id")?.value;
const usuario = await getUsuarioDesdeSesion(sessionId);

if (!usuario) {
  return Astro.redirect("/login");
}

if (usuario.tipo_usuario !== "organizacion") {
  return Astro.redirect("/usuario");
}

const ruta = "/gestion/mascotas";
const q = leerBusqueda(Astro.url);
const estadosValidos = ["activas", "reservadas", "adoptadas", "ocultas"];
const estadoURL = Astro.url.searchParams.get("estado") ?? "";
const estadoActual = estadosValidos.includes(estadoURL) ? estadoURL : "activas";
const filtros = { estado: estadoActual, q };

// Los contadores mantienen el total por estado, independientemente de la búsqueda.
const conteo = await db.query(
  `SELECT COUNT(*) AS total,
     COUNT(*) FILTER (WHERE publicada AND estado_adopcion = 'disponible') AS activas,
     COUNT(*) FILTER (WHERE publicada AND estado_adopcion = 'reservada') AS reservadas,
     COUNT(*) FILTER (WHERE publicada AND estado_adopcion = 'adoptada') AS adoptadas,
     COUNT(*) FILTER (WHERE NOT publicada) AS ocultas
   FROM public.mascotas WHERE usuario_id = $1`, [usuario.id]
);
const contadores = conteo.rows[0];
const totalPublicaciones = Number(contadores.total);
const pestanas = [
  { id: "activas", nombre: "Activas", icono: "fa-circle-check", cantidad: Number(contadores.activas) },
  { id: "reservadas", nombre: "Reservadas", icono: "fa-clock", cantidad: Number(contadores.reservadas) },
  { id: "adoptadas", nombre: "Adoptadas", icono: "fa-heart", cantidad: Number(contadores.adoptadas) },
  { id: "ocultas", nombre: "Ocultas", icono: "fa-eye-slash", cantidad: Number(contadores.ocultas) }
];
const estadoBD = estadoActual === "activas" ? "disponible"
  : estadoActual === "reservadas" ? "reservada" : estadoActual === "adoptadas" ? "adoptada" : "";
const parametros = [usuario.id, estadoActual === "ocultas", estadoBD, q];
const condiciones = `FROM public.mascotas
   WHERE usuario_id = $1
     AND (($2::boolean AND NOT publicada) OR (NOT $2::boolean AND publicada AND estado_adopcion = $3))
     AND ($4::text = '' OR strpos(lower(nombre), lower($4::text)) > 0)`;
const conteoFiltrado = await db.query(`SELECT COUNT(*) AS total ${condiciones}`, parametros);
const total = Number(conteoFiltrado.rows[0].total);
const { pagina, paginas, offset } = calcularPagina(Astro.url, total);
const resultado = await db.query(
  `SELECT id, foto_blob, nombre, descripcion, personalidad, historial_medico,
     estado_adopcion, tipo_mascota, publicada
   ${condiciones} ORDER BY id DESC LIMIT $5 OFFSET $6`,
  [...parametros, MASCOTAS_POR_PAGINA, offset]
);
const mascotas = agregarFotosMascotas(resultado.rows);

---

<Layout
  title="Mis mascotas | KodaApp"
  description="Mascotas publicadas por mi organización."
>
  <Header />

  <main class="management-page ka-gestion-mascotas">
    <div class="management-container">

      <div class="page-header page-header-inline">

        <div>
          <a href="/gestion" class="back-link">
            <i class="fa-solid fa-arrow-left"></i>
            Volver al panel
          </a>

          <span class="section-kicker">
            Administración
          </span>

          <h1>Mis mascotas</h1>

          <p>
            Revisa y edita las mascotas que has publicado.
          </p>
        </div>

        <a
          href="/gestion/crear-mascota"
          class="btn-primary"
        >
          <i class="fa-solid fa-plus"></i>
          Publicar mascota
        </a>

      </div>

          <!-- PESTAÑAS DE ESTADO DE LAS MASCOTAS -->

          {totalPublicaciones > 0 && (
            <nav
              class="mis-mascotas-pestanas"
              aria-label="Filtrar publicaciones por estado"
            >
              {pestanas.map((pestana) => (
                <a
                  href={enlacePagina(ruta, { estado: pestana.id, q })}
                  data-estado={pestana.id}
                  class:list={{
                    "mis-mascotas-pestana": true,
                    "activa": estadoActual === pestana.id
                  }}
                  aria-current={
                    estadoActual === pestana.id
                      ? "page"
                      : undefined
                  }
                >
                  <i class={`fa-solid ${pestana.icono}`}></i>

                  <span>{pestana.nombre}</span>

                  <span class="mis-mascotas-contador">
                    {pestana.cantidad}
                  </span>
                </a>
              ))}
            </nav>
          )}


      <form method="GET" action={ruta} class="ka-busqueda-gestion">
        <input type="hidden" name="estado" value={estadoActual} />
        <label>Buscar por nombre
          <span class="ka-busqueda-campo">
            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
            <input type="search" name="q" value={q} maxlength="100" placeholder="Nombre de tu mascota..." />
          </span>
        </label>
        <button type="submit" class="btn-primary"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> Buscar</button>
        {q && <a href={enlacePagina(ruta, { estado: estadoActual })} class="btn-outline">Limpiar búsqueda</a>}
      </form>

      {
        mascotas.length === 0 ? (
          <section class="empty-state">

            <div class="empty-state-icon">
              <i class="fa-solid fa-paw"></i>
            </div>

            
          <h2>
            {totalPublicaciones === 0
              ? "Todavía no tienes publicaciones"
              : q ? "No encontramos mascotas con ese nombre" : `No tienes mascotas ${estadoActual}`}
          </h2>

          <p>
            {totalPublicaciones === 0
              ? "Cuando publiques una mascota, aparecerá aquí."
              : q ? "Prueba con otro nombre o cambia de pestaña." : "Las mascotas aparecerán automáticamente en esta sección cuando tengan ese estado."}
          </p>


            <a
              href="/gestion/crear-mascota"
              class="btn-primary"
            >
              {totalPublicaciones === 0
                ? "Publicar mi primera mascota"
                : "Publicar otra mascota"}
            </a>

          </section>
        ) : (
          <section class="management-pets-grid">

            {mascotas.map((mascota) => (
              <article class="management-pet-card">

                <div class="management-pet-image">

                  {mascota.foto ? (
                    <img
                      src={mascota.foto}
                      alt={`Foto de ${mascota.nombre}`}
                      loading="lazy"
                    />
                  ) : (
                    <div class="management-pet-placeholder">
                      <i class="fa-solid fa-paw"></i>
                    </div>
                  )}

                  <span
                    class:list={{
                      "pet-status-badge": true,
                      "is-available":
                        mascota.estado_adopcion === "disponible"
                    }}
                  >
                    {mascota.publicada ? mascota.estado_adopcion : "Oculta"}
                  </span>

                </div>

                <div class="management-pet-content">

                  <div class="pet-card-meta">
                    {
                      mascota.tipo_mascota === "perro"
                        ? "Perro"
                        : mascota.tipo_mascota === "gato"
                          ? "Gato"
                          : "Otro"
                    }
                  </div>

                  <h2>{mascota.nombre}</h2>

                  {mascota.descripcion && (
                    <p>{mascota.descripcion}</p>
                  )}

                  <div class="management-pet-info">

                    {mascota.personalidad && (
                      <div>
                        <strong>Personalidad</strong>
                        <span>{mascota.personalidad}</span>
                      </div>
                    )}

                    {mascota.historial_medico && (
                      <div>
                        <strong>Historial médico</strong>
                        <span>{mascota.historial_medico}</span>
                      </div>
                    )}

                  </div>

                  
                  <div class="management-pet-actions">

                    <a
                      href={`/gestion/mascotas/${mascota.id}/editar`}
                      class="btn-outline"
                    >
                      <i class="fa-solid fa-pen"></i>
                      Editar publicación
                    </a>

                    {
                      estadoActual === "ocultas" &&
                      mascota.publicada === false &&
                      mascota.estado_adopcion === "disponible" && (
                        <button
                          type="button"
                          class="btn-primary boton-republicar"
                          data-id={mascota.id}
                        >
                          <i class="fa-solid fa-eye"></i>
                          Volver a publicar
                        </button>
                      )
                    }

                  </div>


                </div>
              </article>
            ))}

          </section>
        )
      }

      <PaginadorMascotas ruta={ruta} filtros={filtros} pagina={pagina} paginas={paginas} total={total} cantidad={mascotas.length} />
    </div>
  </main>
</Layout>


<script>
  document
    .querySelectorAll<HTMLButtonElement>(".boton-republicar")
    .forEach((boton) => {
      boton.addEventListener("click", async () => {
        if (!confirm("¿Volver a publicar esta mascota?")) {
          return;
        }

        boton.disabled = true;

        try {
          const respuesta = await fetch(
            "/api/mascotas/republicar",
            {
              method: "POST",
              credentials: "same-origin",
              headers: {
                "Content-Type": "application/json"
              },
              body: JSON.stringify({
                id: Number(boton.dataset.id)
              })
            }
          );

          const resultado = await respuesta.json();

          if (!respuesta.ok || !resultado.ok) {
            throw new Error(resultado.mensaje);
          }

          window.location.reload();

        } catch (error) {
          boton.disabled = false;

          alert(
            error instanceof Error
              ? error.message
              : "No se pudo publicar la mascota."
          );
        }
      });
    });
</script>
