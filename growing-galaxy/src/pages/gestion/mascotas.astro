---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import { getUsuarioDesdeSesion } from "../../lib/auth";
import { db } from "../../lib/db";

const sessionId =
  Astro.cookies.get("session_id")?.value;

const usuario =
  await getUsuarioDesdeSesion(sessionId);


if (!usuario) {
  return Astro.redirect("/login");
}


if (
  usuario.tipo_usuario !== "rescatista" &&
  usuario.tipo_usuario !== "veterinario"
) {
  return Astro.redirect("/usuario");
}


const resultado =
  await db.query(
    `SELECT
      id,
      nombre,
      descripcion,
      personalidad,
      historial_medico,
      estado_adopcion,
      tipo_mascota,
      foto
    FROM mascotas
    WHERE usuario_id = $1
    ORDER BY id DESC`,
    [usuario.id]
  );


const mascotas =
  resultado.rows;
---

<Layout
  title="Mis mascotas | Kodapp"
  description="Mascotas publicadas por tu cuenta."
>

  <Header />


  <main class="management-page">

    <div class="management-container">


      <!-- ========================================= -->
      <!-- ENCABEZADO -->
      <!-- ========================================= -->

      <div class="page-header page-header-inline">

        <div>

          <a
            href="/gestion"
            class="back-link"
          >
            <i class="fa-solid fa-arrow-left"></i>
            Volver al panel
          </a>

          <span class="section-kicker">
            Administración
          </span>

          <h1>
            Mis mascotas
          </h1>

          <p>
            Revisa las mascotas que has publicado.
          </p>

        </div>


        <a
          href="/gestion/crear-mascota"
          class="btn-primary"
        >
          <i class="fa-solid fa-plus"></i>
          Publicar mascota
        </a>

      </div>


      <!-- ========================================= -->
      <!-- LISTADO -->
      <!-- ========================================= -->

      {
        mascotas.length === 0 ? (

          <section class="empty-state">

            <div class="empty-state-icon">
              <i class="fa-solid fa-paw"></i>
            </div>

            <h2>
              Todavía no tienes publicaciones
            </h2>

            <p>
              Cuando publiques una mascota,
              aparecerá automáticamente en este espacio.
            </p>

            <a
              href="/gestion/crear-mascota"
              class="btn-primary"
            >
              Publicar mi primera mascota
            </a>

          </section>

        ) : (

          <section class="management-pets-grid">

            {mascotas.map((mascota) => (

              <article class="management-pet-card">


                <div class="management-pet-image">

                  {
                    mascota.foto ? (

                      <img
                        src={mascota.foto}
                        alt={`Foto de ${mascota.nombre}`}
                        loading="lazy"
                      />

                    ) : (

                      <div class="management-pet-placeholder">
                        <i class="fa-solid fa-paw"></i>
                      </div>

                    )
                  }


                  <span
                    class:list={{
                      "pet-status-badge":
                        true,
                      "is-available":
                        mascota.estado_adopcion ===
                        "disponible",
                    }}
                  >
                    {mascota.estado_adopcion}
                  </span>

                </div>


                <div class="management-pet-content">

                  <div class="pet-card-meta">
                    {
                      mascota.tipo_mascota === "perro"
                        ? "Perro"
                        : mascota.tipo_mascota === "gato"
                          ? "Gato"
                          : "Otro"
                    }
                  </div>


                  <h2>
                    {mascota.nombre}
                  </h2>


                  {
                    mascota.descripcion && (

                      <p>
                        {mascota.descripcion}
                      </p>

                    )
                  }


                  <div class="management-pet-info">

                    {
                      mascota.personalidad && (

                        <div>

                          <strong>
                            Personalidad
                          </strong>

                          <span>
                            {mascota.personalidad}
                          </span>

                        </div>

                      )
                    }


                    {
                      mascota.historial_medico && (

                        <div>

                          <strong>
                            Historial médico
                          </strong>

                          <span>
                            {mascota.historial_medico}
                          </span>

                        </div>

                      )
                    }

                  </div>


                  <div class="management-pet-actions">

                    <a
                      href={`/mascotas/${mascota.id}`}
                      class="btn-outline"
                    >
                      Ver publicación
                    </a>

                    <a
                      href={`/gestion/mascotas/${mascota.id}/editar`}
                      class="icon-button"
                      aria-label={`Editar ${mascota.nombre}`}
                    >
                      <i class="fa-solid fa-pen"></i>
                    </a>

                  </div>

                </div>

              </article>

            ))}

          </section>

        )
      }

    </div>

  </main>

</Layout>