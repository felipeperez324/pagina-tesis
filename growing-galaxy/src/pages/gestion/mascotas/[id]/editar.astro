
---
/**
 * KODAPP - EDITAR MASCOTA
 *
 * Solo permite editar las publicaciones
 * pertenecientes a la organización conectada.
 */

import Layout from "../../../../layouts/Layout.astro";
import Header from "../../../../components/Header.astro";
import ClasificacionMascota from "../../../../components/ClasificacionMascota.astro";
import { db } from "../../../../lib/db";
import { getUsuarioDesdeSesion } from "../../../../lib/auth";
import { agregarFotosMascotas } from "../../../../lib/fotos";

export const prerender = false;

const usuario = await getUsuarioDesdeSesion(
  Astro.cookies.get("session_id")?.value
);

if (!usuario) {
  return Astro.redirect("/login");
}

if (usuario.tipo_usuario !== "organizacion") {
  return Astro.redirect("/usuario");
}

const id = Number(Astro.params.id);

if (!Number.isSafeInteger(id) || id <= 0) {
  return Astro.redirect("/gestion/mascotas");
}

const resultado = await db.query(
  `SELECT
     id,
     nombre,
     descripcion,
     personalidad,
     personalidad_codigo,
     historial_medico,
     salud_codigo,
     tipo_mascota,
     estado_adopcion
   FROM mascotas
   WHERE id = $1
     AND usuario_id = $2`,
  [id, usuario.id]
);

if (resultado.rows.length === 0) {
  return Astro.redirect("/gestion/mascotas");
}

const mascotas =
  await agregarFotosMascotas(resultado.rows);

const mascota = mascotas[0];
---

<Layout
  title={`Editar ${mascota.nombre} | KodApp`}
  description="Editar una publicación de mascota."
>
  <Header />

  <main class="form-page">
    <div class="form-page-container">

      <!-- ENCABEZADO -->

      <div class="page-header">

        <a
          href="/gestion/mascotas"
          class="back-link"
        >
          <i class="fa-solid fa-arrow-left"></i>
          Volver a mis mascotas
        </a>

        <span class="section-kicker">
          Administración de publicaciones
        </span>

        <h1>Editar publicación</h1>

        <p>
          Modifica los datos de {mascota.nombre}
          y guarda los cambios.
        </p>

      </div>


      <form
        id="editar-mascota-form"
        class="publication-form"
      >

        <input
          type="hidden"
          name="id"
          value={mascota.id}
        />


        <!-- FOTO -->

        <section class="form-section">

          <div class="form-section-header">

            <span class="form-step">01</span>

            <div>
              <h2>Fotografía</h2>
              <p>Puedes mantenerla o reemplazarla.</p>
            </div>

          </div>

          <div class="upload-area">

            <label
              for="foto"
              class="upload-label"
            >

              <div
                id="preview-container"
                class="photo-preview"
              >
                {
                  mascota.foto ? (
                    <img
                      src={mascota.foto}
                      alt={`Foto de ${mascota.nombre}`}
                    />
                  ) : (
                    <>
                      <i class="fa-solid fa-camera"></i>
                      <span>Seleccionar fotografía</span>
                    </>
                  )
                }
              </div>

            </label>

            <input
              id="foto"
              name="foto"
              type="file"
              accept="image/jpeg,image/png,image/webp"
              hidden
            />

            <small>
              Si no seleccionas otra imagen,
              se conserva la actual. Máximo 5 MB.
            </small>

          </div>

        </section>


        <!-- INFORMACIÓN BÁSICA -->

        <section class="form-section">

          <div class="form-section-header">

            <span class="form-step">02</span>

            <div>
              <h2>Datos de la mascota</h2>
              <p>Actualiza su información básica.</p>
            </div>

          </div>

          <div class="form-grid">

            <div class="form-field">

              <label for="nombre">
                Nombre
              </label>

              <input
                id="nombre"
                name="nombre"
                type="text"
                maxlength="100"
                required
                value={mascota.nombre}
              />

            </div>


            <div class="form-field">

              <label for="tipoMascota">
                Tipo de mascota
              </label>

              <select
                id="tipoMascota"
                name="tipoMascota"
                required
              >
                <option
                  value="perro"
                  selected={mascota.tipo_mascota === "perro"}
                >
                  Perro
                </option>

                <option
                  value="gato"
                  selected={mascota.tipo_mascota === "gato"}
                >
                  Gato
                </option>

                <option
                  value="otro"
                  selected={mascota.tipo_mascota === "otro"}
                >
                  Otro
                </option>
              </select>

            </div>


            <div class="form-field form-field-full">

              <label for="descripcion">
                Descripción
              </label>

              <textarea
                id="descripcion"
                name="descripcion"
                rows="5"
                maxlength="5000"
              >{mascota.descripcion ?? ""}</textarea>

            </div>

          </div>

        </section>


        <!-- DESPLEGABLES -->

        <ClasificacionMascota
          personalidad={mascota.personalidad}
          personalidadCodigo={mascota.personalidad_codigo}
          historialMedico={mascota.historial_medico}
          saludCodigo={mascota.salud_codigo}
        />


        <!-- ESTADO DE ADOPCIÓN -->

        <section class="form-section">

          <div class="form-section-header">

            <span class="form-step">05</span>

            <div>
              <h2>Estado de adopción</h2>

              <p>
                Indica si la mascota continúa
                disponible para postulaciones.
              </p>
            </div>

          </div>

          <div class="form-field">

            <label for="estadoAdopcion">
              Estado
            </label>

            <select
              id="estadoAdopcion"
              name="estadoAdopcion"
              required
            >
              <option
                value="disponible"
                selected={
                  mascota.estado_adopcion === "disponible"
                }
              >
                Disponible
              </option>

              <option
                value="reservada"
                selected={
                  mascota.estado_adopcion === "reservada"
                }
              >
                Reservada
              </option>

              <option
                value="adoptada"
                selected={
                  mascota.estado_adopcion === "adoptada"
                }
              >
                Adoptada
              </option>
            </select>

          </div>

        </section>


        <!-- MENSAJE -->

        <p
          id="editar-mensaje"
          class="form-message"
          role="status"
          aria-live="polite"
        ></p>


        <!-- BOTONES -->

        <div class="form-actions">

          <button
            id="eliminar-publicacion"
            type="button"
            class="btn-eliminar-publicacion"
          >
            <i class="fa-solid fa-trash"></i>
            Eliminar publicación
          </button>

          <a
            href="/gestion/mascotas"
            class="btn-outline"
          >
            Cancelar
          </a>

          <button
            id="guardar-cambios"
            type="submit"
            class="btn-primary"
          >
            <i class="fa-solid fa-floppy-disk"></i>
            Guardar cambios
          </button>

        </div>

      </form>

    </div>
  </main>
</Layout>


<script>
  const form =
    document.querySelector<HTMLFormElement>(
      "#editar-mascota-form"
    );

  const fotoInput =
    document.querySelector<HTMLInputElement>(
      "#foto"
    );

  const preview =
    document.querySelector<HTMLElement>(
      "#preview-container"
    );

  const mensaje =
    document.querySelector<HTMLElement>(
      "#editar-mensaje"
    );

  const botonGuardar =
    document.querySelector<HTMLButtonElement>(
      "#guardar-cambios"
    );

  const botonEliminar =
    document.querySelector<HTMLButtonElement>(
      "#eliminar-publicacion"
    );


  // ==========================================
  // VISTA PREVIA DE LA FOTO
  // ==========================================

  fotoInput?.addEventListener("change", () => {
    const archivo = fotoInput.files?.[0];

    if (!archivo || !preview) return;

    if (
      !["image/jpeg", "image/png", "image/webp"]
        .includes(archivo.type) ||
      archivo.size > 5 * 1024 * 1024
    ) {
      alert(
        "Selecciona una imagen JPG, PNG o WebP de hasta 5 MB."
      );

      fotoInput.value = "";
      return;
    }

    const url = URL.createObjectURL(archivo);
    const imagen = document.createElement("img");

    imagen.src = url;
    imagen.alt = "Nueva fotografía";

    imagen.onload = () => {
      URL.revokeObjectURL(url);
    };

    preview.replaceChildren(imagen);
  });


  // ==========================================
  // GUARDAR CAMBIOS
  // ==========================================

  form?.addEventListener("submit", async (evento) => {
    evento.preventDefault();

    if (!form || !botonGuardar || !mensaje) {
      return;
    }

    if (!form.reportValidity()) {
      return;
    }

    botonGuardar.disabled = true;
    mensaje.textContent = "Guardando cambios...";

    try {
      const respuesta = await fetch(
        "/api/mascotas/editar",
        {
          method: "POST",
          credentials: "same-origin",
          body: new FormData(form)
        }
      );

      const resultado = await respuesta.json();

      if (respuesta.status === 401) {
        window.location.href = "/login";
        return;
      }

      if (!respuesta.ok || !resultado.ok) {
        mensaje.textContent =
          resultado.mensaje ||
          "No se pudieron guardar los cambios.";
        return;
      }

      window.location.href = "/gestion/mascotas";

    } catch (error) {
      console.error("Error al editar mascota:", error);

      mensaje.textContent =
        "No se pudo conectar con el servidor.";

    } finally {
      botonGuardar.disabled = false;
    }
  });


  // ==========================================
  // ELIMINAR PUBLICACIÓN
  // ==========================================

  botonEliminar?.addEventListener("click", async () => {
    if (!form || !mensaje || !botonEliminar) {
      return;
    }

    const idInput =
      form.querySelector<HTMLInputElement>(
        'input[name="id"]'
      );

    const id = Number(idInput?.value);

    if (!Number.isSafeInteger(id) || id <= 0) {
      mensaje.textContent =
        "ID de publicación inválido.";
      return;
    }

    const confirmado = window.confirm(
      "¿Estás seguro de eliminar esta publicación?\n\n" +
      "También se eliminará su fotografía.\n" +
      "Esta acción no se puede deshacer."
    );

    if (!confirmado) {
      return;
    }

    botonEliminar.disabled = true;

    if (botonGuardar) {
      botonGuardar.disabled = true;
    }

    mensaje.textContent = "Eliminando publicación...";

    try {
      const respuesta = await fetch(
        "/api/mascotas/eliminar",
        {
          method: "DELETE",
          credentials: "same-origin",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify({ id })
        }
      );

      const resultado = await respuesta.json();

      if (!respuesta.ok || !resultado.ok) {
        mensaje.textContent =
          resultado.mensaje ||
          "No se pudo eliminar la publicación.";
        return;
      }

      if (resultado.advertencia) {
        window.alert(resultado.mensaje);
      }

      window.location.href = "/gestion/mascotas";

    } catch (error) {
      console.error("Error al eliminar:", error);

      mensaje.textContent =
        "No se pudo conectar con el servidor.";

    } finally {
      botonEliminar.disabled = false;

      if (botonGuardar) {
        botonGuardar.disabled = false;
      }
    }
  });
</script>
