
---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import { db } from "../../lib/db";
import { getUsuarioDesdeSesion } from "../../lib/auth";
import "../../styles/postulaciones.css";

export const prerender = false;

const usuario = await getUsuarioDesdeSesion(
  Astro.cookies.get("session_id")?.value
);

if (!usuario) {
  return Astro.redirect("/login");
}

if (usuario.tipo_usuario !== "organizacion") {
  return Astro.redirect("/usuario");
}

// Solo muestra solicitudes de mascotas publicadas
// por la organización que inició sesión.
const resultado = await db.query(
  `SELECT
     p.id,
     p.mascota_id,
     p.telefono,
     p.vivienda,
     p.motivo,
     p.estado,
     p.creada_en,
     p.resuelta_en,
     m.nombre AS mascota_nombre,
     u.nombre AS adoptante_nombre,
     u.correo AS adoptante_correo
   FROM postulaciones p
   JOIN mascotas m
     ON m.id = p.mascota_id
   JOIN usuarios u
     ON u.id = p.adoptante_id
   WHERE m.usuario_id = $1
   ORDER BY
     CASE WHEN p.estado = 'pendiente' THEN 0 ELSE 1 END,
     p.creada_en DESC`,
  [usuario.id]
);

const postulaciones = resultado.rows;

const fecha = (valor: Date | string) =>
  new Date(valor).toLocaleDateString("es-CL", {
    day: "2-digit",
    month: "long",
    year: "numeric"
  });
---

<Layout
  title="Postulaciones recibidas | KodApp"
  description="Revisa y evalúa postulaciones para tus mascotas."
>
  <Header />

  <main class="post-page">
    <div class="post-container">

      <div class="post-heading">
        <a href="/gestion" class="back-link">
          <i class="fa-solid fa-arrow-left"></i>
          Volver a gestión
        </a>

        <span class="section-kicker">
          Panel de organización
        </span>

        <h1>Postulaciones recibidas</h1>

        <p>
          Revisa los antecedentes de los adoptantes
          que postularon a tus mascotas.
        </p>
      </div>

      <p
        id="mensaje-evaluacion"
        class="post-message"
        role="status"
        aria-live="polite"
      ></p>

      {
        postulaciones.length === 0 ? (
          <div class="post-empty">
            <i class="fa-solid fa-clipboard-list"></i>

            <h2>No tienes postulaciones</h2>

            <p>
              Cuando alguien postule a una de tus mascotas,
              su solicitud aparecerá aquí.
            </p>
          </div>
        ) : (
          <div class="post-list">
            {postulaciones.map((postulacion) => (
              <article class="post-entry">

                <span
                  class={`post-status is-${postulacion.estado}`}
                >
                  {postulacion.estado}
                </span>

                <h2>
                  {postulacion.mascota_nombre}
                </h2>

                <p>
                  <strong>Postulante:</strong>
                  {" "}
                  {postulacion.adoptante_nombre}
                </p>

                <p>
                  <strong>Correo:</strong>
                  {" "}
                  {postulacion.adoptante_correo}
                </p>

                <p>
                  <strong>Teléfono:</strong>
                  {" "}
                  {postulacion.telefono}
                </p>

                <p>
                  <strong>Vivienda:</strong>
                  {" "}
                  {postulacion.vivienda}
                </p>

                <p class="post-date">
                  Postulación recibida:
                  {" "}
                  {fecha(postulacion.creada_en)}
                </p>

                <div class="post-detail">
                  <strong>Motivación del adoptante</strong>
                  <p>{postulacion.motivo}</p>
                </div>

                {
                  postulacion.estado === "pendiente" && (
                    <form
                      class="post-decision-form"
                      data-postulacion-id={postulacion.id}
                    >
                      <button
                        type="submit"
                        name="decision"
                        value="aprobar"
                        class="btn-primary"
                      >
                        <i class="fa-solid fa-check"></i>
                        Aprobar postulación
                      </button>

                      <button
                        type="submit"
                        name="decision"
                        value="rechazar"
                        class="post-reject"
                      >
                        <i class="fa-solid fa-xmark"></i>
                        Rechazar postulación
                      </button>
                    </form>
                  )
                }

                {
                  postulacion.estado !== "pendiente" && (
                    <p class="post-date">
                      Evaluada:
                      {" "}
                      {postulacion.resuelta_en
                        ? fecha(postulacion.resuelta_en)
                        : "Sin fecha"}
                    </p>
                  )
                }

              </article>
            ))}
          </div>
        )
      }

    </div>
  </main>
</Layout>

<script>
  /**
   * Recoger la decisión de la organización
   * y enviarla a la API de postulaciones.
   */

  const mensaje =
    document.querySelector<HTMLElement>(
      "#mensaje-evaluacion"
    );

  const formularios =
    document.querySelectorAll<HTMLFormElement>(
      ".post-decision-form"
    );

  formularios.forEach((formulario) => {
    formulario.addEventListener(
      "submit",
      async (evento) => {
        evento.preventDefault();

        const boton = (
          evento as SubmitEvent
        ).submitter as HTMLButtonElement | null;

        const decision = boton?.value;

        if (
          decision !== "aprobar" &&
          decision !== "rechazar"
        ) {
          return;
        }

        const confirmado = window.confirm(
          decision === "aprobar"
            ? "¿Seguro que deseas aprobar esta postulación?"
            : "¿Seguro que deseas rechazar esta postulación?"
        );

        if (!confirmado) return;

        const botones =
          formulario.querySelectorAll<HTMLButtonElement>(
            "button"
          );

        botones.forEach((b) => {
          b.disabled = true;
        });

        try {
          const respuesta = await fetch(
            "/api/postulaciones/resolver",
            {
              method: "POST",
              credentials: "same-origin",
              headers: {
                "Content-Type": "application/json"
              },
              body: JSON.stringify({
                postulacionId: Number(
                  formulario.dataset.postulacionId
                ),
                decision
              })
            }
          );

          const resultado = await respuesta.json();

          if (respuesta.status === 401) {
            window.location.href = "/login";
            return;
          }

          if (!respuesta.ok || !resultado.ok) {
            throw new Error(
              resultado.mensaje ||
              "No se pudo evaluar la postulación."
            );
          }

          window.location.reload();

        } catch (error) {
          if (mensaje) {
            mensaje.textContent =
              error instanceof Error
                ? error.message
                : "Error al guardar la decisión.";

            mensaje.dataset.estado = "error";

            mensaje.scrollIntoView({
              behavior: "smooth",
              block: "center"
            });
          }

          botones.forEach((b) => {
            b.disabled = false;
          });
        }
      }
    );
  });
</script>
