---
import Layout from "../layouts/Layout.astro";
import "../styles/login.css";
---

<Layout
  title="Registrarse"
  description="Crea una cuenta en la plataforma de adopción."
>

  <main class="auth-page">

    <div class="auth-card">

      <div class="auth-header">

        <div class="auth-logo">
          🐾
        </div>

        <h1>Crear cuenta</h1>

        <p>
          Regístrate para comenzar.
        </p>

      </div>

      <form id="registro-form">

        <label for="name">
          Nombre completo
        </label>

        <input
          id="name"
          name="nombre"
          type="text"
          placeholder="Tu nombre"
          required
        />

        <label for="rut">
          RUT
        </label>

        <input
          id="rut"
          name="rut"
          type="text"
          placeholder="12.345.678-9"
          required
        />

        <label for="email">
          Correo electrónico
        </label>

        <input
          id="email"
          name="correo"
          type="email"
          placeholder="correo@ejemplo.com"
          required
        />

        <label for="role">
          Tipo de cuenta
        </label>

        <select
          id="role"
          name="tipoUsuario"
          required
        >

          <option value="adoptante">
            Adoptante
          </option>

          <option value="rescatista">
            Rescatista
          </option>

          <option value="veterinario">
            Veterinario
          </option>

        </select>

        <label for="password">
          Contraseña
        </label>

        <input
          id="password"
          name="contrasena"
          type="password"
          placeholder="••••••••"
          minlength="6"
          required
        />

        <button
          type="submit"
          class="auth-button"
        >
          Crear cuenta
        </button>

        <p id="registro-message"></p>

      </form>

      <p class="auth-register">

        ¿Ya tienes una cuenta?

        <a href="/login">
          Inicia sesión
        </a>

      </p>

    </div>

  </main>

</Layout>

<script>
  const form = document.querySelector("#registro-form");
  const message = document.querySelector("#registro-message");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    const nombreInput = document.querySelector(
      "#name"
    ) as HTMLInputElement;

    const rutInput = document.querySelector(
      "#rut"
    ) as HTMLInputElement;

    const correoInput = document.querySelector(
      "#email"
    ) as HTMLInputElement;

    const tipoUsuarioInput = document.querySelector(
      "#role"
    ) as HTMLSelectElement;

    const contrasenaInput = document.querySelector(
      "#password"
    ) as HTMLInputElement;

    const nombre = nombreInput.value;
    const rut = rutInput.value;
    const correo = correoInput.value;
    const tipoUsuario = tipoUsuarioInput.value;
    const contrasena = contrasenaInput.value;

    if (message) {
      message.textContent = "Creando cuenta...";
    }

    try {
      const response = await fetch("/api/registro", {
        method: "POST",

        headers: {
          "Content-Type": "application/json"
        },

        body: JSON.stringify({
          nombre,
          rut,
          correo,
          tipoUsuario,
          contrasena
        })
      });

      const data = await response.json();

      if (!response.ok) {
        if (message) {
          message.textContent = data.mensaje;
        }

        return;
      }

      if (message) {
        message.textContent = "¡Cuenta creada correctamente!";
      }

      window.location.href = "/login";
          } catch (error) {
            console.error(error);

      if (message) {
        message.textContent =
          "No se pudo conectar con el servidor.";
      }
    }
  });
</script>