
---
import Layout from "../layouts/Layout.astro";
import MascotasAuth from "../components/MascotasAuth.astro";
import "../styles/login.css";
---

<Layout
  title="Crear cuenta | KodApp"
  description="Regístrate en KodApp."
>
  <main class="ka-auth">
    <div class="ka-auth__layout">

      <!-- IZQUIERDA: MASCOTAS ANIMADAS -->
      <div class="ka-auth__visual">
        <MascotasAuth />
      </div>

      <!-- DERECHA: REGISTRO -->
      <section class="ka-auth__card">

        <a href="/" class="ka-auth__brand">
          <i class="fa-solid fa-paw"></i>
          KodApp
        </a>

        <h1>¡Únete a nuestra familia!</h1>

        <p class="ka-auth__description">
          Crea tu cuenta y comienza una nueva historia.
        </p>

        <form id="registro-form" class="ka-form">

          <!-- NOMBRE -->
          <div class="ka-field">
            <input
              id="name"
              name="nombre"
              type="text"
              placeholder=" "
              maxlength="100"
              autocomplete="name"
              required
            />
            <label for="name">Nombre completo</label>
          </div>

          <!-- RUT -->
          <div class="ka-field">
            <input
              id="rut"
              name="rut"
              type="text"
              placeholder=" "
              maxlength="12"
              required
            />
            <label for="rut">RUT</label>
            <small class="ka-field__hint">
              Ejemplo: 12.345.678-9
            </small>
          </div>

          <!-- CORREO -->
          <div class="ka-field">
            <input
              id="email"
              name="correo"
              type="email"
              placeholder=" "
              maxlength="150"
              autocomplete="email"
              required
            />
            <label for="email">Correo electrónico</label>
          </div>

          <!-- TIPO DE CUENTA -->
          <div class="ka-field ka-field--select">
            <label for="role">Tipo de cuenta</label>
            <select
              id="role"
              name="tipoUsuario"
              required
            >
              <option value="">Selecciona una opción</option>
              <option value="adoptante">Adoptante</option>
              <option value="rescatista">Rescatista</option>
              <option value="veterinario">Veterinario</option>
            </select>
          </div>

          <!-- CONTRASEÑA -->
          <div class="ka-field">
            <input
              id="password"
              name="contrasena"
              type="password"
              placeholder=" "
              minlength="6"
              autocomplete="new-password"
              required
            />
            <label for="password">Contraseña</label>

            <button
              type="button"
              class="ka-password-toggle"
              data-ka-toggle
              aria-label="Mostrar contraseña"
              aria-pressed="false"
            >
              <i class="fa-solid fa-eye"></i>
            </button>
          </div>

          <!-- BOTÓN ANIMADO -->
          <button type="submit" class="ka-submit" id="register-submit">
            <span></span>
            <span></span>
            <span></span>
            <span></span>

            Crear cuenta
            <i class="fa-solid fa-heart"></i>
          </button>

          <p
            id="registro-message"
            class="ka-form__message"
            role="status"
            aria-live="polite"
          ></p>

        </form>

        <p class="ka-auth__footer">
          ¿Ya tienes una cuenta?
          <a href="/login">Inicia sesión</a>
        </p>

        <a href="/" class="ka-auth__back">
          <i class="fa-solid fa-arrow-left"></i>
          Volver al inicio
        </a>

      </section>
    </div>
  </main>
</Layout>

<script>
  // =========================================
  // CONEXIÓN CON LA API DE REGISTRO
  // =========================================

  const form = document.querySelector<HTMLFormElement>("#registro-form");
  const message = document.querySelector<HTMLElement>("#registro-message");
  const submit = document.querySelector<HTMLButtonElement>("#register-submit");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    if (!message || !submit) return;

    const name = form.querySelector<HTMLInputElement>("#name");
    const rut = form.querySelector<HTMLInputElement>("#rut");
    const email = form.querySelector<HTMLInputElement>("#email");
    const role = form.querySelector<HTMLSelectElement>("#role");
    const password = form.querySelector<HTMLInputElement>("#password");

    if (!name || !rut || !email || !role || !password) return;

    submit.disabled = true;
    message.textContent = "Creando tu cuenta...";
    message.dataset.status = "";

    try {
      // Se mantienen los nombres de campos de la API existente.
      const response = await fetch("/api/registro", {
        method: "POST",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify({
          nombre: name.value.trim(),
          rut: rut.value.trim(),
          correo: email.value.trim(),
          tipoUsuario: role.value,
          contrasena: password.value
        })
      });

      const data = await response.json();

      if (!response.ok || !data.ok) {
        message.textContent =
          data.mensaje || "No se pudo crear tu cuenta.";
        return;
      }

      message.dataset.status = "success";
      message.textContent = "¡Cuenta creada correctamente!";

      // Continuamos con el mismo flujo que ya funcionaba.
      window.location.href = "/login";

    } catch (error) {
      console.error("Error de registro:", error);
      message.textContent = "No se pudo conectar con el servidor.";

    } finally {
      submit.disabled = false;
    }
  });
</script>
