---
import Layout from "../layouts/Layout.astro";
import "../styles/login.css";
---

<Layout
  title="Registrarse"
  description="Crea una cuenta en la plataforma de adopción."
>

  <main class="auth-page">

    <div class="auth-card">

      <div class="auth-header">

        <div class="auth-logo">
          🐾
        </div>

        <h1>Crear cuenta</h1>

        <p>
          Regístrate para comenzar.
        </p>

      </div>


      <form>

        <label for="name">
          Nombre completo
        </label>

        <input
          id="name"
          type="text"
          placeholder="Tu nombre"
          required
        />


        <label for="email">
          Correo electrónico
        </label>

        <input
          id="email"
          type="email"
          placeholder="correo@ejemplo.com"
          required
        />


        <label for="role">
          Tipo de cuenta
        </label>

        <select id="role">

          <option value="adoptante">
            Adoptante
          </option>

          <option value="rescatista">
            Rescatista
          </option>

          <option value="veterinario">
            Veterinario
          </option>

        </select>


        <label for="password">
          Contraseña
        </label>

        <input
          id="password"
          type="password"
          placeholder="••••••••"
          required
        />


        <button
          type="submit"
          class="auth-button"
        >
          Crear cuenta
        </button>

      </form>


      <p class="auth-register">

        ¿Ya tienes una cuenta?

        <a href="/login">
          Inicia sesión
        </a>

      </p>

    </div>

  </main>

</Layout>