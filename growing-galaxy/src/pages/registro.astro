
---
import Layout from "../layouts/Layout.astro";
import MascotasAuth from "../components/MascotasAuth.astro";
import "../styles/login.css";
---

<Layout
  title="Crear cuenta | KodApp"
  description="Regístrate en KodApp con verificación de correo."
>
  <main class="ka-auth">
    <div class="ka-auth__layout">

      <div class="ka-auth__visual">
        <MascotasAuth />
      </div>

      <section class="ka-auth__card">
        <a href="/" class="ka-auth__brand">
          <i class="fa-solid fa-paw"></i>
          KodApp
        </a>

        <h1>¡Únete a nuestra familia!</h1>

        <p class="ka-auth__description">
          Crea tu cuenta y comienza una nueva historia.
          Primero verificaremos tu correo electrónico.
        </p>

        <form id="registro-form" class="ka-form">

          <!-- NOMBRE -->
          <div class="ka-field">
            <input
              id="name"
              name="nombre"
              type="text"
              placeholder=" "
              maxlength="100"
              autocomplete="name"
              required
            />
            <label for="name">Nombre completo</label>
          </div>

          <!-- RUT -->
          <div class="ka-field">
            <input
              id="rut"
              name="rut"
              type="text"
              placeholder=" "
              maxlength="12"
              autocomplete="off"
              aria-describedby="rut-ayuda"
              required
            />

            <label for="rut">RUT</label>

            <small
              id="rut-ayuda"
              class="ka-field__hint"
              aria-live="polite"
            >
              Ejemplo: 12.345.678-5
            </small>
          </div>

          <!-- CORREO -->
          <div class="ka-field">
            <input
              id="email"
              name="correo"
              type="email"
              placeholder=" "
              maxlength="150"
              autocomplete="email"
              required
            />

            <label for="email">
              Correo electrónico
            </label>
          </div>

          <!-- VERIFICACIÓN -->
          <div class="ka-verification">

            <div class="ka-verification__title">
              <i class="fa-solid fa-shield-halved"></i>
              <strong>Verificación de correo</strong>
            </div>

            <p>
              Enviaremos un código de seguridad
              de 6 dígitos a tu correo.
            </p>

            <button
              type="button"
              id="send-code"
              class="ka-verify-button"
            >
              <i class="fa-solid fa-envelope"></i>
              Enviar código
            </button>

            <div class="ka-field ka-verification__input">
              <input
                id="verification-code"
                name="codigo"
                type="text"
                placeholder=" "
                inputmode="numeric"
                autocomplete="one-time-code"
                maxlength="6"
                disabled
              />

              <label for="verification-code">
                Código de seguridad
              </label>
            </div>

            <button
              type="button"
              id="verify-code"
              class="ka-verify-button ka-verify-button--confirm"
              disabled
            >
              <i class="fa-solid fa-check-circle"></i>
              Verificar código
            </button>

            <p
              id="verification-message"
              class="ka-verification__message"
              role="status"
              aria-live="polite"
            >
              Tu correo todavía no está verificado.
            </p>

          </div>

          <!-- TIPO DE CUENTA -->
          <div class="ka-field ka-field--select">
            <label for="role">Tipo de cuenta</label>

            <select
              id="role"
              name="tipoUsuario"
              required
            >
              <option value="">Selecciona una opción</option>
              <option value="adoptante">Adoptante</option>
              <option value="organizacion">Organización</option>
            </select>
          </div>

          <!-- CONTRASEÑA -->
          <div class="ka-field">
            <input
              id="password"
              name="contrasena"
              type="password"
              placeholder=" "
              minlength="8"
              maxlength="72"
              autocomplete="new-password"
              required
            />

            <label for="password">Contraseña</label>

            <button
              type="button"
              class="ka-password-toggle"
              data-ka-toggle
              aria-label="Mostrar contraseña"
              aria-pressed="false"
            >
              <i class="fa-solid fa-eye"></i>
            </button>
          </div>

          <!-- CREAR CUENTA -->
          <button
            type="submit"
            class="ka-submit"
            id="register-submit"
            disabled
          >
            <span></span>
            <span></span>
            <span></span>
            <span></span>

            Crear cuenta
            <i class="fa-solid fa-heart"></i>
          </button>

          <p
            id="registro-message"
            class="ka-form__message"
            role="status"
            aria-live="polite"
          ></p>

        </form>

        <p class="ka-auth__footer">
          ¿Ya tienes una cuenta?
          <a href="/login">Inicia sesión</a>
        </p>

        <a href="/" class="ka-auth__back">
          <i class="fa-solid fa-arrow-left"></i>
          Volver al inicio
        </a>

      </section>
    </div>
  </main>
</Layout>

<script>
  import {
    validarRut,
    formatearRut
  } from "../lib/rut";

  const form = document.querySelector<HTMLFormElement>(
    "#registro-form"
  );

  const name = document.querySelector<HTMLInputElement>(
    "#name"
  );

  const rut = document.querySelector<HTMLInputElement>(
    "#rut"
  );

  const rutAyuda = document.querySelector<HTMLElement>(
    "#rut-ayuda"
  );

  const email = document.querySelector<HTMLInputElement>(
    "#email"
  );

  const role = document.querySelector<HTMLSelectElement>(
    "#role"
  );

  const password = document.querySelector<HTMLInputElement>(
    "#password"
  );

  const sendButton = document.querySelector<HTMLButtonElement>(
    "#send-code"
  );

  const verifyButton = document.querySelector<HTMLButtonElement>(
    "#verify-code"
  );

  const codeInput = document.querySelector<HTMLInputElement>(
    "#verification-code"
  );

  const verificationMessage =
    document.querySelector<HTMLElement>(
      "#verification-message"
    );

  const registerButton =
    document.querySelector<HTMLButtonElement>(
      "#register-submit"
    );

  const registerMessage =
    document.querySelector<HTMLElement>(
      "#registro-message"
    );

  let comprobante = "";
  let correoConfirmado = "";

  let envioEnCurso = false;
  let verificacionEnCurso = false;
  let registroEnCurso = false;

  const esperasMemoria = new Map<string, number>();

  function normalizarCorreo(valor: string): string {
    return valor.trim().toLowerCase();
  }

  function correoActual(): string {
    return normalizarCorreo(email?.value ?? "");
  }

  // ==========================================
  // TEMPORIZADOR DE 60 SEGUNDOS
  // ==========================================

  function claveEspera(correo: string): string {
    // La espera se conserva al recargar la página.
    return `kodapp:registro:espera:v60:${encodeURIComponent(correo)}`;
  }

  function obtenerFinEspera(correo: string): number {
    if (!correo) return 0;

    let fin = esperasMemoria.get(correo) ?? 0;

    try {
      const guardado = Number(
        sessionStorage.getItem(claveEspera(correo)) ?? 0
      );

      if (Number.isFinite(guardado)) {
        fin = Math.max(fin, guardado);
      }
    } catch {
      // El registro sigue funcionando si el navegador
      // restringe el almacenamiento de sesión.
    }

    return fin;
  }

  function segundosRestantes(correo: string): number {
    const diferencia = obtenerFinEspera(correo) - Date.now();

    return Math.max(
      0,
      Math.ceil(diferencia / 1000)
    );
  }

  function establecerEspera(
    correo: string,
    segundos: number
  ): void {
    if (!correo) return;

    const espera = Math.max(
      0,
      Math.ceil(segundos)
    );

    const fin = Date.now() + espera * 1000;

    esperasMemoria.set(correo, fin);

    try {
      sessionStorage.setItem(
        claveEspera(correo),
        String(fin)
      );
    } catch {
      // El temporizador también se conserva en memoria.
    }

    actualizarBotonEnvio();
  }

  // Guardamos solo que hay un código pendiente.
  // Nunca guardamos el código ni la contraseña.
  function claveCodigo(correo: string): string {
    return `kodapp:registro:codigo:${encodeURIComponent(correo)}`;
  }

  function guardarCodigoPendiente(
    correo: string,
    segundos: number
  ): void {
    try {
      if (segundos > 0) {
        sessionStorage.setItem(
          claveCodigo(correo),
          String(Date.now() + segundos * 1000)
        );
      }
    } catch {}
  }

  function hayCodigoPendiente(correo: string): boolean {
    try {
      const hasta = Number(
        sessionStorage.getItem(claveCodigo(correo)) ?? 0
      );

      return Number.isFinite(hasta) && hasta > Date.now();
    } catch {
      return false;
    }
  }

  function recuperarCodigoPendiente(): void {
    const correo = correoActual();

    if (!codeInput || !verifyButton || comprobante) {
      return;
    }

    const pendiente = hayCodigoPendiente(correo);

    codeInput.disabled = !pendiente;
    verifyButton.disabled = !pendiente;
  }

  // ==========================================
  // ACTUALIZAR BOTÓN DE ENVÍO
  // ==========================================

  function actualizarBotonEnvio(): void {
    if (!sendButton) return;

    const correo = correoActual();

    if (envioEnCurso) {
      sendButton.disabled = true;

      sendButton.innerHTML =
        '<i class="fa-solid fa-spinner fa-spin"></i> Enviando...';

      return;
    }

    if (
      comprobante &&
      correoConfirmado === correo
    ) {
      sendButton.disabled = true;

      sendButton.innerHTML =
        '<i class="fa-solid fa-check"></i> Correo verificado';

      return;
    }

    const restantes = segundosRestantes(correo);

    if (restantes > 0) {
      sendButton.disabled = true;

      sendButton.innerHTML =
        `<i class="fa-solid fa-clock"></i> Reenviar en ${restantes} s`;

      return;
    }

    sendButton.disabled = false;

    const tieneCodigo = hayCodigoPendiente(correo);

    sendButton.innerHTML = tieneCodigo
      ? '<i class="fa-solid fa-rotate"></i> Reenviar código'
      : '<i class="fa-solid fa-envelope"></i> Enviar código';
  }

  // Se actualiza usando la hora real.
  window.setInterval(actualizarBotonEnvio, 1000);

  document.addEventListener(
    "visibilitychange",
    actualizarBotonEnvio
  );

  // ==========================================
  // VALIDAR RUT EN EL FORMULARIO
  // ==========================================

  function validarRutVisual(): boolean {
    if (!rut) return false;

    const valor = rut.value.trim();

    if (!valor) {
      rut.setCustomValidity("");

      if (rutAyuda) {
        rutAyuda.textContent = "Ejemplo: 12.345.678-5";
      }

      return false;
    }

    const valido = validarRut(valor);

    if (valido) {
      rut.setCustomValidity("");

      if (rutAyuda) {
        rutAyuda.textContent =
          "Dígito verificador correcto (módulo 11).";
      }
    } else {
      rut.setCustomValidity(
        "El RUT no tiene un dígito verificador válido."
      );

      if (rutAyuda) {
        rutAyuda.textContent =
          "Revisa el RUT y su dígito verificador.";
      }
    }

    return valido;
  }

  rut?.addEventListener("input", () => {
    rut.value = rut.value.replace(/[^0-9kK.\-\s]/g, "");

    validarRutVisual();
  });

  rut?.addEventListener("blur", () => {
    if (validarRutVisual()) {
      rut.value = formatearRut(rut.value);
    }
  });

  // ==========================================
  // ESTADOS DEL REGISTRO
  // ==========================================

  function actualizarRegistro(): void {
    if (!registerButton) return;

    registerButton.disabled =
      registroEnCurso ||
      !comprobante ||
      correoConfirmado !== correoActual();
  }

  function mostrarEstado(
    mensaje: string,
    estado: "success" | "error" | "" = ""
  ): void {
    if (!verificationMessage) return;

    verificationMessage.textContent = mensaje;
    verificationMessage.dataset.status = estado;
  }

  // Cambiar el correo invalida el comprobante
  // en memoria, pero no el tiempo de espera
  // del correo anterior.
  email?.addEventListener("input", () => {
    comprobante = "";
    correoConfirmado = "";

    if (codeInput) {
      codeInput.value = "";
      codeInput.disabled = true;
    }

    if (verifyButton) {
      verifyButton.disabled = true;
    }

    mostrarEstado(
      "Tu correo todavía no está verificado."
    );

    recuperarCodigoPendiente();
    actualizarBotonEnvio();
    actualizarRegistro();
  });

  codeInput?.addEventListener("input", () => {
    codeInput.value = codeInput.value
      .replace(/\D/g, "")
      .slice(0, 6);
  });

  // ==========================================
  // ENVIAR / REENVIAR CÓDIGO
  // ==========================================

  sendButton?.addEventListener(
    "click",
    async () => {
      if (
        !email ||
        !sendButton ||
        !codeInput ||
        !verifyButton ||
        envioEnCurso
      ) {
        return;
      }

      if (!email.reportValidity()) return;

      const correoSolicitud = correoActual();

      if (segundosRestantes(correoSolicitud) > 0) {
        actualizarBotonEnvio();
        return;
      }

      envioEnCurso = true;
      actualizarBotonEnvio();

      try {
        const respuesta = await fetch(
          "/api/reenviarcodigo",
          {
            method: "POST",
            headers: {
              "Content-Type": "application/json"
            },
            body: JSON.stringify({
              correo: correoSolicitud
            })
          }
        );

        const datos = await respuesta.json();

        const esperaServidor = Number(
          datos.esperaSegundos ??
          respuesta.headers.get("Retry-After") ??
          0
        );

        if (
          (respuesta.ok && datos.ok) ||
          respuesta.status === 429
        ) {
          if (
            Number.isFinite(esperaServidor) &&
            esperaServidor > 0
          ) {
            establecerEspera(
              correoSolicitud,
              esperaServidor
            );
          }
        }

        // Si cambió el correo durante el envío,
        // no alteramos el formulario actual.
        if (correoActual() !== correoSolicitud) {
          return;
        }

        if (respuesta.status === 429) {
          // Permitir utilizar un código anterior
          // que siga siendo válido.
          if (datos.codigoPendiente === true) {
            guardarCodigoPendiente(
              correoSolicitud,
              Number(datos.codigoExpiraSegundos) || 0
            );

            codeInput.disabled = false;
            verifyButton.disabled = false;
          }

          mostrarEstado(
            datos.mensaje ||
            "Debes esperar antes de reenviar.",
            "error"
          );

          return;
        }

        if (!respuesta.ok || !datos.ok) {
          mostrarEstado(
            datos.mensaje ||
            "No se pudo enviar el código.",
            "error"
          );

          return;
        }

        comprobante = "";
        correoConfirmado = "";

        guardarCodigoPendiente(
          correoSolicitud,
          Number(datos.codigoExpiraSegundos) || 900
        );

        codeInput.value = "";
        codeInput.disabled = false;
        verifyButton.disabled = false;

        mostrarEstado(
          "¡Código enviado! Revisa tu correo. " +
          "Puedes reenviarlo después de 60 segundos.",
          "success"
        );

        actualizarRegistro();

      } catch (error) {
        console.error(
          "Error al enviar código:",
          error
        );

        if (correoActual() === correoSolicitud) {
          mostrarEstado(
            "No se pudo conectar con el servidor.",
            "error"
          );
        }

      } finally {
        envioEnCurso = false;
        actualizarBotonEnvio();
      }
    }
  );

  // ==========================================
  // VERIFICAR CÓDIGO - SISTEMA ORIGINAL
  // ==========================================

  verifyButton?.addEventListener(
    "click",
    async () => {
      if (
        !email ||
        !codeInput ||
        !verifyButton ||
        verificacionEnCurso
      ) {
        return;
      }

      const correoSolicitud = correoActual();
      const codigo = codeInput.value.trim();

      if (!/^\d{6}$/.test(codigo)) {
        mostrarEstado(
          "El código debe tener 6 números.",
          "error"
        );

        return;
      }

      verificacionEnCurso = true;
      verifyButton.disabled = true;

      mostrarEstado("Verificando código...");

      try {
        const respuesta = await fetch(
          "/api/verificarcorreo",
          {
            method: "POST",
            headers: {
              "Content-Type": "application/json"
            },
            body: JSON.stringify({
              correo: correoSolicitud,
              codigo
            })
          }
        );

        const datos = await respuesta.json();

        if (correoActual() !== correoSolicitud) {
          return;
        }

        if (
          !respuesta.ok ||
          !datos.ok ||
          !datos.comprobante
        ) {
          mostrarEstado(
            datos.mensaje ||
            "Código incorrecto.",
            "error"
          );

          return;
        }

        comprobante = datos.comprobante;
        correoConfirmado = correoSolicitud;

        try {
          sessionStorage.removeItem(
            claveCodigo(correoSolicitud)
          );
        } catch {}

        codeInput.disabled = true;

        mostrarEstado(
          "¡Correo verificado correctamente!",
          "success"
        );

        actualizarRegistro();
        actualizarBotonEnvio();

      } catch (error) {
        console.error(
          "Error al verificar código:",
          error
        );

        if (correoActual() === correoSolicitud) {
          mostrarEstado(
            "No se pudo verificar el código.",
            "error"
          );
        }

      } finally {
        verificacionEnCurso = false;

        if (correoActual() === correoSolicitud) {
          verifyButton.disabled =
            Boolean(comprobante) ||
            codeInput.disabled;
        }

        actualizarBotonEnvio();
      }
    }
  );

  // ==========================================
  // CREAR CUENTA - SISTEMA ORIGINAL
  // ==========================================

  form?.addEventListener(
    "submit",
    async (evento) => {
      evento.preventDefault();

      if (
        !name ||
        !rut ||
        !email ||
        !role ||
        !password ||
        !registerButton ||
        !registerMessage ||
        registroEnCurso
      ) {
        return;
      }

      if (!validarRutVisual()) {
        rut.reportValidity();
        return;
      }

      if (!form.reportValidity()) return;

      if (
        !comprobante ||
        correoConfirmado !== correoActual()
      ) {
        registerMessage.textContent =
          "Debes verificar tu correo antes de registrarte.";

        registerMessage.dataset.status = "error";
        return;
      }

      registroEnCurso = true;
      actualizarRegistro();

      registerMessage.textContent =
        "Creando tu cuenta...";

      registerMessage.dataset.status = "";

      try {
        const respuesta = await fetch(
          "/api/registro",
          {
            method: "POST",
            headers: {
              "Content-Type": "application/json"
            },
            body: JSON.stringify({
              nombre: name.value.trim(),
              rut: formatearRut(rut.value),
              correo: correoActual(),
              tipoUsuario: role.value,
              contrasena: password.value,
              comprobante
            })
          }
        );

        const datos = await respuesta.json();

        if (!respuesta.ok || !datos.ok) {
          registerMessage.dataset.status = "error";

          registerMessage.textContent =
            datos.mensaje ||
            "No se pudo crear la cuenta.";

          return;
        }

        comprobante = "";

        try {
          sessionStorage.removeItem(
            claveCodigo(correoActual())
          );

          sessionStorage.removeItem(
            claveEspera(correoActual())
          );
        } catch {}

        registerMessage.dataset.status = "success";

        registerMessage.textContent =
          "¡Cuenta creada correctamente!";

        window.location.href = "/login";

      } catch (error) {
        console.error(
          "Error al registrar:",
          error
        );

        registerMessage.dataset.status = "error";

        registerMessage.textContent =
          "No se pudo conectar con el servidor.";

      } finally {
        registroEnCurso = false;
        actualizarRegistro();
      }
    }
  );

  validarRutVisual();
  recuperarCodigoPendiente();
  actualizarBotonEnvio();
  actualizarRegistro();
</script>
