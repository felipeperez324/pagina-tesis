---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Crear cuenta | Kodapp"
  description="Crea tu cuenta en Kodapp."
>

  <main class="auth-page">

    <section class="auth-layout auth-layout-register">

      <div class="auth-intro">

        <a
          href="/"
          class="auth-brand"
        >
          Kodapp
        </a>

        <span class="section-kicker">
          Únete a Kodapp
        </span>

        <h1>
          Empieza una nueva historia.
        </h1>

        <p>
          Crea tu cuenta y forma parte del proceso
          de adopción responsable.
        </p>


        <div class="register-benefits">

          <div class="register-benefit">
            <i class="fa-solid fa-heart"></i>
            <span>
              Encuentra mascotas compatibles contigo.
            </span>
          </div>

          <div class="register-benefit">
            <i class="fa-solid fa-clipboard-check"></i>
            <span>
              Gestiona tus formularios y postulaciones.
            </span>
          </div>

          <div class="register-benefit">
            <i class="fa-solid fa-paw"></i>
            <span>
              Participa en adopciones responsables.
            </span>
          </div>

        </div>

      </div>


      <div class="auth-card">

        <div class="auth-card-header">

          <div class="auth-icon">
            <i class="fa-solid fa-user-plus"></i>
          </div>

          <h2>
            Crear cuenta
          </h2>

          <p>
            Completa tus datos para registrarte.
          </p>

        </div>


        <form id="registro-form">

          <div class="form-field">

            <label for="name">
              Nombre completo
            </label>

            <div class="input-shell">

              <i class="fa-solid fa-user"></i>

              <input
                id="name"
                name="nombre"
                type="text"
                placeholder="Tu nombre"
                autocomplete="name"
                required
              />

            </div>

          </div>


          <div class="form-field">

            <label for="rut">
              RUT
            </label>

            <div class="input-shell">

              <i class="fa-solid fa-id-card"></i>

              <input
                id="rut"
                name="rut"
                type="text"
                placeholder="12.345.678-9"
                required
              />

            </div>

          </div>


          <div class="form-field">

            <label for="email">
              Correo electrónico
            </label>

            <div class="input-shell">

              <i class="fa-solid fa-envelope"></i>

              <input
                id="email"
                name="correo"
                type="email"
                placeholder="correo@ejemplo.com"
                autocomplete="email"
                required
              />

            </div>

          </div>


          <div class="form-field">

            <label for="role">
              Tipo de cuenta
            </label>

            <div class="input-shell">

              <i class="fa-solid fa-users"></i>

              <select
                id="role"
                name="tipoUsuario"
                required
              >

                <option value="adoptante">
                  Adoptante
                </option>

                <option value="rescatista">
                  Rescatista
                </option>

                <option value="veterinario">
                  Veterinario
                </option>

              </select>

            </div>

          </div>


          <div class="form-field">

            <label for="password">
              Contraseña
            </label>

            <div class="input-shell">

              <i class="fa-solid fa-lock"></i>

              <input
                id="password"
                name="contrasena"
                type="password"
                placeholder="Mínimo 6 caracteres"
                minlength="6"
                autocomplete="new-password"
                required
              />

            </div>

          </div>


          <button
            type="submit"
            class="btn-primary auth-submit"
          >
            Crear cuenta
            <i class="fa-solid fa-arrow-right"></i>
          </button>


          <p
            id="registro-message"
            class="form-message"
          ></p>

        </form>


        <p class="auth-switch">
          ¿Ya tienes una cuenta?

          <a href="/login">
            Inicia sesión
          </a>
        </p>

      </div>

    </section>

  </main>

</Layout>


<script>
  // =========================================
  // REGISTRO
  // =========================================

  const registerForm =
    document.querySelector(
      "#registro-form"
    ) as HTMLFormElement | null;

  const registerMessage =
    document.querySelector(
      "#registro-message"
    ) as HTMLElement | null;


  registerForm?.addEventListener(
    "submit",
    async (event) => {

      event.preventDefault();


      const nombreInput =
        document.querySelector(
          "#name"
        ) as HTMLInputElement | null;

      const rutInput =
        document.querySelector(
          "#rut"
        ) as HTMLInputElement | null;

      const correoInput =
        document.querySelector(
          "#email"
        ) as HTMLInputElement | null;

      const tipoUsuarioInput =
        document.querySelector(
          "#role"
        ) as HTMLSelectElement | null;

      const contrasenaInput =
        document.querySelector(
          "#password"
        ) as HTMLInputElement | null;


      if (
        !nombreInput ||
        !rutInput ||
        !correoInput ||
        !tipoUsuarioInput ||
        !contrasenaInput
      ) {
        return;
      }


      const nombre =
        nombreInput.value.trim();

      const rut =
        rutInput.value.trim();

      const correo =
        correoInput.value.trim();

      const tipoUsuario =
        tipoUsuarioInput.value;

      const contrasena =
        contrasenaInput.value;


      if (registerMessage) {
        registerMessage.textContent =
          "Creando cuenta...";
      }


      try {

        const response =
          await fetch(
            "/api/registro",
            {
              method: "POST",

              headers: {
                "Content-Type":
                  "application/json",
              },

              body: JSON.stringify({
                nombre,
                rut,
                correo,
                tipoUsuario,
                contrasena,
              }),
            }
          );


        const data =
          await response.json();


        if (!response.ok) {

          if (registerMessage) {
            registerMessage.textContent =
              data.mensaje ||
              "No se pudo crear la cuenta.";
          }

          return;
        }


        if (registerMessage) {
          registerMessage.textContent =
            "¡Cuenta creada correctamente!";
        }


        window.location.href =
          "/login";


      } catch (error) {

        console.error(
          "Error al registrarse:",
          error
        );


        if (registerMessage) {
          registerMessage.textContent =
            "No se pudo conectar con el servidor.";
        }

      }

    }
  );
</script>