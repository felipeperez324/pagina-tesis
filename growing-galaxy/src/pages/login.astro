---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Iniciar sesión | Kodapp"
  description="Inicia sesión en Kodapp."
>

  <main class="auth-page">

    <section class="auth-layout">

      <div class="auth-intro">

        <a
          href="/"
          class="auth-brand"
        >
          Kodapp
        </a>

        <span class="section-kicker">
          Bienvenido de vuelta
        </span>

        <h1>
          Tu próximo compañero
          puede estar esperándote.
        </h1>

        <p>
          Inicia sesión para continuar con tus adopciones,
          revisar tus formularios y descubrir nuevas mascotas.
        </p>

      </div>


      <div class="auth-card">

        <div class="auth-card-header">

          <div class="auth-icon">
            <i class="fa-solid fa-paw"></i>
          </div>

          <h2>
            Iniciar sesión
          </h2>

          <p>
            Accede a tu cuenta de Kodapp.
          </p>

        </div>


        <form id="login-form">

          <div class="form-field">

            <label for="email">
              Correo electrónico
            </label>

            <div class="input-shell">

              <i class="fa-solid fa-envelope"></i>

              <input
                id="email"
                name="correo"
                type="email"
                placeholder="correo@ejemplo.com"
                autocomplete="email"
                required
              />

            </div>

          </div>


          <div class="form-field">

            <label for="password">
              Contraseña
            </label>

            <div class="input-shell">

              <i class="fa-solid fa-lock"></i>

              <input
                id="password"
                name="contrasena"
                type="password"
                placeholder="••••••••"
                autocomplete="current-password"
                required
              />

            </div>

          </div>


          <button
            type="submit"
            class="btn-primary auth-submit"
          >
            Iniciar sesión
            <i class="fa-solid fa-arrow-right"></i>
          </button>


          <p
            id="login-message"
            class="form-message"
          ></p>

        </form>


        <div class="auth-divider">
          <span>¿Nuevo en Kodapp?</span>
        </div>


        <a
          href="/registro"
          class="btn-outline"
        >
          Crear una cuenta
        </a>

      </div>

    </section>

  </main>

</Layout>


<script>
  // =========================================
  // LOGIN
  // =========================================

  const loginForm =
    document.querySelector(
      "#login-form"
    ) as HTMLFormElement | null;

  const loginMessage =
    document.querySelector(
      "#login-message"
    ) as HTMLElement | null;


  loginForm?.addEventListener(
    "submit",
    async (event) => {

      event.preventDefault();


      const correoInput =
        document.querySelector(
          "#email"
        ) as HTMLInputElement | null;

      const contrasenaInput =
        document.querySelector(
          "#password"
        ) as HTMLInputElement | null;


      if (
        !correoInput ||
        !contrasenaInput
      ) {
        return;
      }


      const correo =
        correoInput.value.trim();

      const contrasena =
        contrasenaInput.value;


      if (loginMessage) {
        loginMessage.textContent =
          "Iniciando sesión...";
      }


      try {

        const response =
          await fetch(
            "/api/login",
            {
              method: "POST",

              headers: {
                "Content-Type":
                  "application/json",
              },

              body: JSON.stringify({
                correo,
                contrasena,
              }),
            }
          );


        const data =
          await response.json();


        if (!response.ok) {

          if (loginMessage) {
            loginMessage.textContent =
              data.mensaje ||
              "No se pudo iniciar sesión.";
          }

          return;
        }


        if (
          !data.ok ||
          !data.usuario
        ) {

          if (loginMessage) {
            loginMessage.textContent =
              "La respuesta del servidor no es válida.";
          }

          return;
        }


        // =========================================
        // REDIRECCIÓN SEGÚN ROL
        // =========================================

        if (
          data.usuario.tipoUsuario ===
          "adoptante"
        ) {

          window.location.href =
            "/usuario";

          return;
        }


        if (
          data.usuario.tipoUsuario ===
            "rescatista" ||
          data.usuario.tipoUsuario ===
            "veterinario"
        ) {

          window.location.href =
            "/gestion";

          return;
        }


        if (loginMessage) {
          loginMessage.textContent =
            "El tipo de usuario no es válido.";
        }


      } catch (error) {

        console.error(
          "Error al iniciar sesión:",
          error
        );


        if (loginMessage) {
          loginMessage.textContent =
            "No se pudo conectar con el servidor.";
        }

      }

    }
  );
</script>