
---
import Layout from "../layouts/Layout.astro";
import MascotasAuth from "../components/MascotasAuth.astro";
import "../styles/login.css";
---

<Layout
  title="Iniciar sesión | KodApp"
  description="Inicia sesión en KodApp."
>
  <main class="ka-auth">
    <div class="ka-auth__layout">

      <div class="ka-auth__visual">
        <MascotasAuth />
      </div>

      <section class="ka-auth__card">

        <a href="/" class="ka-auth__brand">
          <i class="fa-solid fa-paw"></i>
          KodApp
        </a>

        <h1>¡Bienvenido de vuelta!</h1>

        <p class="ka-auth__description">
          Inicia sesión para conocer a tu próximo compañero.
        </p>

        <form id="login-form" class="ka-form">

          <div class="ka-field">
            <input
              id="email"
              name="correo"
              type="email"
              placeholder=" "
              autocomplete="email"
              required
            />
            <label for="email">Correo electrónico</label>
          </div>

          <div class="ka-field">
            <input
              id="password"
              name="contrasena"
              type="password"
              placeholder=" "
              autocomplete="current-password"
              required
            />
            <label for="password">Contraseña</label>

            <button
              type="button"
              class="ka-password-toggle"
              data-ka-toggle
              aria-label="Mostrar contraseña"
              aria-pressed="false"
            >
              <i class="fa-solid fa-eye"></i>
            </button>
          </div>

          <button
            type="submit"
            class="ka-submit"
            id="login-submit"
          >
            <span></span>
            <span></span>
            <span></span>
            <span></span>

            Iniciar sesión
            <i class="fa-solid fa-arrow-right"></i>
          </button>

          <p
            id="login-message"
            class="ka-form__message"
            role="status"
            aria-live="polite"
          ></p>

        </form>

        <p class="ka-auth__footer">
          ¿Todavía no tienes una cuenta?
          <a href="/registro">Regístrate aquí</a>
        </p>

        <a href="/" class="ka-auth__back">
          <i class="fa-solid fa-arrow-left"></i>
          Volver al inicio
        </a>

      </section>
    </div>
  </main>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>(
    "#login-form"
  );

  const mensaje = document.querySelector<HTMLElement>(
    "#login-message"
  );

  const boton = document.querySelector<HTMLButtonElement>(
    "#login-submit"
  );

  form?.addEventListener("submit", async (evento) => {
    evento.preventDefault();

    if (!mensaje || !boton) return;

    const correo = form.querySelector<HTMLInputElement>(
      "#email"
    );

    const contrasena = form.querySelector<HTMLInputElement>(
      "#password"
    );

    if (!correo || !contrasena) return;

    boton.disabled = true;
    mensaje.textContent = "Comprobando tus datos...";
    mensaje.dataset.status = "";

    try {
      const respuesta = await fetch("/api/login", {
        method: "POST",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify({
          correo: correo.value.trim(),
          contrasena: contrasena.value
        })
      });

      const datos = await respuesta.json();

      if (!respuesta.ok || !datos.ok) {
        mensaje.textContent =
          datos.mensaje || "No se pudo iniciar sesión.";
        return;
      }

      const tipo = datos.usuario?.tipoUsuario;

      if (tipo === "adoptante") {
        window.location.href = "/usuario";
        return;
      }

      if (tipo === "organizacion") {
        window.location.href = "/gestion";
        return;
      }

      mensaje.textContent = "Tipo de cuenta no válido.";

    } catch (error) {
      console.error("Error de inicio de sesión:", error);
      mensaje.textContent = "No se pudo conectar con el servidor.";

    } finally {
      boton.disabled = false;
    }
  });
</script>
