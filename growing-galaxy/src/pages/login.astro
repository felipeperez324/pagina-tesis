
---
import Layout from "../layouts/Layout.astro";
import MascotasAuth from "../components/MascotasAuth.astro";
import "../styles/login.css";
---

<Layout
  title="Iniciar sesión | KodApp"
  description="Inicia sesión en KodApp."
>
  <main class="ka-auth">
    <div class="ka-auth__layout">

      <!-- IZQUIERDA: MASCOTAS ANIMADAS -->
      <div class="ka-auth__visual">
        <MascotasAuth />
      </div>

      <!-- DERECHA: LOGIN -->
      <section class="ka-auth__card">

        <a href="/" class="ka-auth__brand">
          <i class="fa-solid fa-paw"></i>
          KodApp
        </a>

        <h1>¡Bienvenido de vuelta!</h1>

        <p class="ka-auth__description">
          Inicia sesión para conocer a tu próximo compañero.
        </p>

        <form id="login-form" class="ka-form">

          <!-- CORREO -->
          <div class="ka-field">
            <input
              id="email"
              name="correo"
              type="email"
              placeholder=" "
              autocomplete="email"
              required
            />
            <label for="email">Correo electrónico</label>
          </div>

          <!-- CONTRASEÑA -->
          <div class="ka-field">
            <input
              id="password"
              name="contrasena"
              type="password"
              placeholder=" "
              autocomplete="current-password"
              required
            />
            <label for="password">Contraseña</label>

            <!-- El componente MascotasAuth controla este botón -->
            <button
              type="button"
              class="ka-password-toggle"
              data-ka-toggle
              aria-label="Mostrar contraseña"
              aria-pressed="false"
            >
              <i class="fa-solid fa-eye"></i>
            </button>
          </div>

          <!-- BOTÓN ANIMADO -->
          <button type="submit" class="ka-submit" id="login-submit">
            <span></span>
            <span></span>
            <span></span>
            <span></span>

            Iniciar sesión
            <i class="fa-solid fa-arrow-right"></i>
          </button>

          <p
            id="login-message"
            class="ka-form__message"
            role="status"
            aria-live="polite"
          ></p>
        </form>

        <p class="ka-auth__footer">
          ¿Todavía no tienes una cuenta?
          <a href="/registro">Regístrate aquí</a>
        </p>

        <a href="/" class="ka-auth__back">
          <i class="fa-solid fa-arrow-left"></i>
          Volver al inicio
        </a>

      </section>
    </div>
  </main>
</Layout>

<script>
  // =========================================
  // CONEXIÓN CON LA API DE LOGIN
  // =========================================

  const form = document.querySelector<HTMLFormElement>("#login-form");
  const message = document.querySelector<HTMLElement>("#login-message");
  const submit = document.querySelector<HTMLButtonElement>("#login-submit");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    if (!message || !submit) return;

    const email = form.querySelector<HTMLInputElement>("#email");
    const password = form.querySelector<HTMLInputElement>("#password");

    if (!email || !password) return;

    submit.disabled = true;
    message.textContent = "Comprobando tus datos...";
    message.dataset.status = "";

    try {
      // Se conserva el endpoint original de KodApp.
      const response = await fetch("/api/login", {
        method: "POST",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify({
          correo: email.value.trim(),
          contrasena: password.value
        })
      });

      const data = await response.json();

      if (!response.ok || !data.ok) {
        message.textContent =
          data.mensaje || "No se pudo iniciar sesión.";
        return;
      }

      message.dataset.status = "success";
      message.textContent = "¡Bienvenido a KodApp!";

      // Redirección según rol existente.
      const role = data.usuario?.tipoUsuario;

      if (role === "adoptante") {
        window.location.href = "/usuario";
        return;
      }

      if (role === "rescatista" || role === "veterinario") {
        window.location.href = "/gestion";
        return;
      }

      message.dataset.status = "";
      message.textContent = "Tipo de usuario no válido.";

    } catch (error) {
      console.error("Error de login:", error);
      message.textContent = "No se pudo conectar con el servidor.";

    } finally {
      submit.disabled = false;
    }
  });
</script>
