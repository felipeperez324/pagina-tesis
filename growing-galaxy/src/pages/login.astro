---
import Layout from "../layouts/Layout.astro";
import "../styles/login.css";
---
<Layout
  title="Iniciar sesión"
  description="Inicia sesión en la plataforma de adopción.">
  <main class="auth-page">

    <div class="auth-card">
      <div class="auth-header">
        <div class="auth-logo">
          🐾
        </div>
        <h1>Bienvenido</h1>
        <p>
          Inicia sesión para continuar.
        </p>
      </div>
      <form>
        <label for="email">
          Correo electrónico
        </label>
        <input
          id="email"
          type="email"
          placeholder="correo@ejemplo.com"
          required/>
        <label for="password">
          Contraseña
        </label>
        <input
          id="password"
          type="password"
          placeholder="••••••••"
          required
        />
        <button
          type="submit"
          class="auth-button">
          Iniciar sesión
        </button>
      </form>
      <p class="auth-register">
        ¿No tienes una cuenta?
        <a href="/registro">
          Regístrate
        </a>
      </p>
    </div>
  </main>
</Layout>