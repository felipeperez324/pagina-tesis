---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import "../styles/match.css";
---
<Layout title="Compatibilidad para adoptantes | KodApp">
  <Header />
  <main class="ka-match-page">
    <div class="ka-match-container">
      <section class="ka-match-empty">
        <i class="fa-solid fa-heart" aria-hidden="true"></i>
        <h1>La compatibilidad es para adoptantes</h1>
        <p>Las cuentas de organización no pueden realizar el match. Esta función compara las preferencias de cada adoptante con las mascotas disponibles.</p>
        <a class="ka-match-action" href="/gestion">Volver a mi gestión</a>
      </section>
    </div>
  </main>
</Layout>
