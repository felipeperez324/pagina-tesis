
---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import { db } from "../lib/db";
import { getUsuarioDesdeSesion } from "../lib/auth";
import "../styles/postulaciones.css";

export const prerender = false;

const usuario = await getUsuarioDesdeSesion(
  Astro.cookies.get("session_id")?.value
);

if (!usuario) {
  return Astro.redirect("/login");
}

if (usuario.tipo_usuario !== "adoptante") {
  return Astro.redirect("/gestion");
}

const resultado = await db.query(
  `SELECT
     p.id,
     p.mascota_id,
     p.estado,
     p.creada_en,
     p.resuelta_en,
     m.nombre AS mascota_nombre,
     m.tipo_mascota,
     u.nombre AS organizacion_nombre
   FROM postulaciones p
   JOIN mascotas m
     ON m.id = p.mascota_id
   JOIN usuarios u
     ON u.id = m.usuario_id
   WHERE p.adoptante_id = $1
   ORDER BY p.creada_en DESC`,
  [usuario.id]
);

const postulaciones = resultado.rows;

const fecha = (valor: Date | string) =>
  new Date(valor).toLocaleDateString("es-CL", {
    day: "2-digit",
    month: "long",
    year: "numeric"
  });
---

<Layout
  title="Mis postulaciones | KodApp"
  description="Consulta el estado de tus postulaciones de adopción."
>
  <Header />

  <main class="post-page">
    <div class="post-container">

      <div class="post-heading">
        <a href="/usuario" class="back-link">
          <i class="fa-solid fa-arrow-left"></i>
          Volver a mi cuenta
        </a>

        <span class="section-kicker">
          Mi proceso
        </span>

        <h1>Mis postulaciones</h1>

        <p>
          Aquí puedes consultar las solicitudes que
          has enviado a las organizaciones.
        </p>
      </div>

      {
        postulaciones.length === 0 ? (
          <section class="post-empty">
            <i class="fa-solid fa-paw"></i>

            <h2>Aún no tienes postulaciones</h2>

            <p>
              Explora las mascotas disponibles
              y envía tu primera solicitud.
            </p>

            <a href="/usuario" class="btn-primary">
              Ver mascotas disponibles
            </a>
          </section>
        ) : (
          <div class="post-list">
            {postulaciones.map((postulacion) => (
              <article class="post-entry">

                <span
                  class={`post-status is-${postulacion.estado}`}
                >
                  {postulacion.estado}
                </span>

                <h2>{postulacion.mascota_nombre}</h2>

                <p>
                  <strong>Organización:</strong>
                  {" "}
                  {postulacion.organizacion_nombre}
                </p>

                <p>
                  <strong>Tipo de mascota:</strong>
                  {" "}
                  {postulacion.tipo_mascota}
                </p>

                <p class="post-date">
                  Enviada el:
                  {" "}
                  {fecha(postulacion.creada_en)}
                </p>

                {
                  postulacion.estado === "pendiente" && (
                    <p>
                      Tu solicitud está esperando
                      la evaluación de la organización.
                    </p>
                  )
                }

                {
                  postulacion.estado === "aprobada" && (
                    <p>
                      Tu postulación fue aprobada.
                      La organización puede contactarte
                      para continuar el proceso.
                      Esto todavía no significa que
                      la adopción esté completada.
                    </p>
                  )
                }

                {
                  postulacion.estado === "rechazada" && (
                    <p>
                      Tu postulación no fue aprobada.
                      Puedes explorar otras mascotas
                      disponibles en KodApp.
                    </p>
                  )
                }

                <div class="post-entry-actions">
                  <a
                    href={`/postular/${postulacion.mascota_id}`}
                    class="btn-secondary"
                  >
                    Ver mascota
                  </a>
                </div>

              </article>
            ))}
          </div>
        )
      }

    </div>
  </main>
</Layout>
