---

<Layout
  title="Kodapp"
  description="Encuentra mascotas que buscan un hogar responsable en Kodapp."
>
  <Header />

  <main class="container content-layout">
    <section class="main-column">
      <div class="query-message">
        <span>
          Se muestran las entradas que coinciden con la búsqueda de
          <strong>“mascotas en adopción”</strong>
        </span>
        <a href="https://www.Kodappstore.com/">Mostrar todo</a>
      </div>

      <div class="post-grid">
        {posts.map((post) => <PostCard {...post} />)}
      </div>

      <div class="load-more">
        <a href="https://www.Kodappstore.com/search?q=mascotas+pc+y+laptop&by-date=true">
          Cargar más entradas
        </a>
      </div>
    </section>

    <Sidebar />
  </main>

  <Footer />
</Layout>
