---
import "../styles/decoraciones.css";
import "../styles/global.css";


import ControlInactividad from "../components/controlinactividad.astro";

// Solo incluir el detector cuando existe una cookie
// de sesión y estamos fuera de login/registro.
const tieneSesion =
  Boolean(Astro.cookies.get("session_id")?.value);

const paginaPublicaAuth =
  Astro.url.pathname === "/login" ||
  Astro.url.pathname === "/registro";

const usarControl =
  tieneSesion && !paginaPublicaAuth;



interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Kodapp",
  description = "Plataforma de adopción responsable de mascotas."
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <!-- Color principal del nuevo diseño -->
    <meta
      name="theme-color"
      content="#1E2229"
    />

    <meta
      name="description"
      content={description}
    />

    <title>{title}</title>

    <link
      rel="icon"
      href="/logo.png"
      type="image/png"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css"
    />

    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fira+Sans:wght@400;500;600;700;800&family=Nunito:wght@400;500;600;700;800&display=swap"
    />
  </head>

  <body>
    <!-- Control de inactividad para usuarios conectados -->
    {usarControl && <ControlInactividad />}

    <slot />
  </body>
</html>